GORUN_NAME=Gorun
GORUN_ADDRESS=0.0.0.0:8080
GORUN_EVENT_TOPIC="gorun.events"

# OTEL enviconment variables https://opentelemetry.io/docs/specs/otel/configuration/sdk-environment-variables/
# Add any that you need

# GORUN_NAME will be used for OTEL service name if empty or not found.
# OTEL_SERICE_NAME=Gorun
OTEL_SDK_DISABLED=false
OTEL_RESOURCE_ATTRIBUTES=""
OTEL_LOG_LEVEL="info"

# NATS client settings
# GORUN_NAME will be used for NATS client name if empty or not found.
# GORUN_NATS_CLIENT_NAME=Gorun
GORUN_NATS_CLIENT_URL=nats://localhost:4222
GORUN_NATS_CLIENT_RECONNECT_WAIT=2s
GORUN_NATS_CLIENT_TIMEOUT=5s
GORUN_NATS_CLIENT_ALLOW_RECONNECT=true

# NATS server settings
GORUN_NATS_SERVER_CONFIG=~/.config/gorun/nats-server.conf
