package ui

templ Index() {
	@Base("Gorun Dashboard") {
		<div class="relative overflow-hidden">
			<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-accent/20 via-zinc-950 to-zinc-950"></div>
			<main class="relative mx-auto max-w-6xl px-6 py-10">
				<header class="mb-8">
					<h1 class="text-4xl font-bold tracking-tight">
						<span class="bg-gradient-to-br from-white to-zinc-400 bg-clip-text text-transparent">Gorun</span>
						<span class="ml-2 text-zinc-500">dashboard</span>
					</h1>
					<p class="mt-2 text-zinc-400">Realtime events from gorun processes.</p>
				</header>

				<section class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 backdrop-blur">
					<div class="mb-4 flex items-center justify-between">
						<h2 class="text-lg font-semibold">Live events</h2>
						<span class="text-xs text-zinc-500">streaming via NATS</span>
					</div>
					<div id="event-log" class="space-y-2" data-init="@get('/events')"></div>
				</section>
			</main>
		</div>
	}
}