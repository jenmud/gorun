package ui

templ Index() {
	@Base("Gorun") {
		<div class="relative overflow-hidden">
			<div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-accent/20 via-zinc-950 to-zinc-950"></div>
			<main class="relative mx-auto max-w-5xl px-6 py-20">
				<header class="mb-16">
					<div class="inline-flex items-center gap-2 rounded-full border border-zinc-800 bg-zinc-900/60 px-3 py-1 text-xs text-zinc-400 backdrop-blur">
						<span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
						live
					</div>
					<h1 class="mt-6 text-5xl font-bold tracking-tight sm:text-6xl">
						<span class="bg-gradient-to-br from-white to-zinc-400 bg-clip-text text-transparent">Gorun</span>
					</h1>
					<p class="mt-4 max-w-2xl text-lg text-zinc-400">
						Run tasks on multiple servers with an interactive TUI — and now a web UI.
					</p>
				</header>

				<section class="grid gap-6 sm:grid-cols-2">
					<div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 backdrop-blur transition hover:border-zinc-700">
						<h2 class="text-lg font-semibold">Servers</h2>
						<p class="mt-2 text-sm text-zinc-400">Manage and select deployment targets.</p>
					</div>
					<div class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 backdrop-blur transition hover:border-zinc-700">
						<h2 class="text-lg font-semibold">Tasks</h2>
						<p class="mt-2 text-sm text-zinc-400">Define and run task pipelines.</p>
					</div>
				</section>

				<section
					class="mt-12 rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 backdrop-blur"
					data-signals="{count: 0}"
				>
					<h2 class="text-lg font-semibold">Datastar demo</h2>
					<p class="mt-2 text-sm text-zinc-400">Reactive counter powered by Datastar.</p>
					<div class="mt-6 flex items-center gap-4">
						<button
							data-on:click="$count++"
							class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white transition hover:bg-violet-500 focus:outline-none focus:ring-2 focus:ring-accent/50"
						>
							Increment
						</button>
						<span class="text-2xl font-semibold tabular-nums" data-text="$count"></span>
					</div>
				</section>
			</main>
		</div>
	}
}