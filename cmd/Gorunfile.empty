# Gorunfile — a starting point from `gorun -dump`.
#
# The uncommented part works as-is: it runs two tasks on this machine.
#   gorun Gorunfile                # pick servers and tasks, then run
#   gorun Gorunfile --run          # run everything without the picker (-r)
#   gorun Gorunfile --list-servers # show what each server would run
#
# Relative paths (cmd_file, copy src, identityfile, ...) are relative to this file.
# Unknown keys are errors, so typos don't go unnoticed.
#
# Settings are templates, filled in for each server: write {{ .Name }}, {{ .Hostname }},
# {{ .Server.Vars.port }} and so on in a task's cmd, cmd_file script, check, verify, envvars,
# vars and copy dst, and in vars and envvars anywhere. Text without {{ is used as it is.
# raw = true keeps a task's (or a server's, group's, bundle's, copy's) text exactly as written,
# for commands that use {{ themselves, like docker ps --format '{{.Names}}'.

title = "My deployment"
log_level = "info"                # debug | info | warn | error; servers and tasks inherit it
# max_parallel = 4                # hosts at once; 0 (default) = all; -parallel N overrides
# max_task_parallel = -1            # tasks at once per host; 0 (default) = one at a time, -1 = all
envvars = { APP_ENV = "development" }   # exported to every task (a task's own envvars win)
# vars = { region = "home" }             # template data for every server: {{ .Server.Vars.region }}
# raw = true                             # keep the global vars and envvars exactly as written
# include = [
#   "tasks/*.toml",                                                # local files, relative to this one
#   "git::https://github.com/you/tasks.git//web/*.toml?ref=v1.2.0", # tasks from a git repository, pinned
# ]

# Global SSH settings: only config_file is used. Setting it gives every host SSH settings,
# so hosts without their own (like localhost below) would run over SSH too and skip their
# local = true tasks. Put shared logins on a server group instead (see below).
# [ssh]
# config_file = "~/.ssh/config"   # fills in user/port/key/hostname a host doesn't set

#
# Tasks: define each once in the library, then refer to it by name.
#

[tasks.hello]
description = "Say hello"         # one line, shown in lists, the picker and the TUI
cmd = "echo 'hello from {{.Name}}, tags:{{range .Tags}} #{{.}}{{end}}'"   # a template, filled in per server
rerun = "safe"                    # safe | unsafe; omit if you don't know
local = true                      # runs on localhost below; tasks without it only run over SSH

[tasks.show-env]
description = "Print the environment this server runs with"
cmd = 'echo "APP_ENV=$APP_ENV REGION=$REGION"'
depends_on = ["hello"]            # always pulled in and run first
rerun = "safe"
local = true

# Every task option (pick one command source: cmd or cmd_file; a task can also be copies only):
# [tasks.example]
# cmd = "apt-get install -y nginx"            # a template: "echo {{.Name}} {{index .EnvVars \"REGION\"}}"
# cmd_file = "./scripts/setup.sh"             # a local script, filled in and sent to the server
# raw = true                      # no templates: cmd, check, verify, envvars, vars and copies as written
# description = "Install nginx"
# details = "A longer explanation, shown when the task is expanded."
# rerun = "unsafe"                # marks it ⚠ in lists and the TUI
# sudo = true
# shell = "sh -c"                 # default
# depends_on = ["packages"]
# log_level = "debug"
# timeout = "15m"                 # default 30m; a timeout fails with exit code 124
# retries = 2                     # extra attempts after a failure (default 0)
# retry_delay = "5s"              # wait before each retry (default 50ms, "0s" = immediately)
# retry_unsafe = false            # allow retries of a rerun = "unsafe" task
# local = true                    # only on local (no-SSH) servers; without it, only over SSH
# check = "grep -q v2.4 /etc/app/version"  # runs first: exit 0 = nothing to do, so the task
#                                 # is unchanged; any other exit code runs it; --force skips it
# check_copies = true             # compare the MD5 of each copy with the file on the server
#                                 # (md5sum, md5 or openssl there; with none, it just copies):
#                                 # all the same (and check, if set, exits 0) = unchanged
# verify = "curl -fs localhost:8080/health"  # runs after the command: non-zero fails the task
#                                 # without check or check_copies, a task always runs
# envvars = { NGINX_PORT = "8080", SITE = "{{ .Name }}" }  # values are templates too
# vars = { port = 8080 }          # template data for this task only: {{.vars.port}}
#                                 # may nest: [[tasks.example.vars.sites]] is a list
#
# [[tasks.example.copy]]          # copies run before the command
# src = "./files/nginx.conf"      # a file, or a directory (copied recursively)
# dst = "/etc/nginx/nginx.conf"   # or dir = "/etc/nginx/" to keep the file name
# mode = "0644"
#
# [[tasks.example.copy]]
# src = "./templates/site.conf.tmpl"  # or content = "inline text {{ .Name }}", a template
# render = true                   # fill the src file in as a template (files are sent as they are without it)
# dst = "{{ .Server.Vars.config }}/site.conf"  # dst and dir are templates
# raw = true                      # keep this copy's dst and content exactly as written

#
# Bundles: named task lists. Use "@name" in any task list, or `--task @name`.
#

[bundles.base]
description = "What every server gets"
tasks = ["hello", "show-env"]     # tasks and/or other "@bundles"
# vars = { port = 8080 }              # template data for this bundle's tasks
# raw = true                          # keep this bundle's vars exactly as written

#
# Server groups: defaults shared by the hosts that list them in `groups`. Later groups
# override earlier ones and the host's own settings win: log_level and each ssh field
# take the last value set, envvars merge by key, tags add up, and the group's tasks are
# appended to [servers] tasks (unless the host sets its own tasks).
#

[server_groups.local]
tags = ["local"]                  # select with --tag local
envvars = { REGION = "home" }

# [server_groups.prod]
# tags = ["prod"]
# tasks = ["@base"]
# log_level = "warn"
# envvars = { APP_ENV = "production" }
# vars = { region = "eu-west-1", config = "/etc/{{ .Name }}" }  # templates, filled in per server
# raw = true                      # keep this group's vars and envvars exactly as written
#   [server_groups.prod.ssh]
#   username = "deploy"
#   identityfile = "~/.ssh/id_ed25519"
#   port = 22

#
# Servers. Every host runs [servers] tasks plus its groups' tasks, unless it sets its
# own `tasks`, which replace both. Then add_tasks are appended and skip_tasks removed.
#

[servers]
tasks = ["@base"]

[servers.hosts.localhost]         # no hostname and no ssh: runs local = true tasks on this machine
groups = ["local"]
tags = ["dev"]

# [servers.hosts.web-01]
# hostname = "web-01.example.com"
# groups = ["prod"]               # selection: --group prod, --tag web, --server 'web-*'
# tags = ["web"]
# tasks = ["@base"]               # replaces [servers] tasks and the groups' tasks
# add_tasks = ["example"]         # appended to the list
# skip_tasks = ["show-env"]       # removed from the list
# envvars = { REGION = "eu-west-1" }
# vars = { region = "eu-west-1" }
# raw = true                      # keep this server's own vars and envvars exactly as written
# log_level = "info"
#   [servers.hosts.web-01.ssh]    # fills in what the groups don't set
#   username = "root"
#   port = 22
#   identityfile = "~/.ssh/id_ed25519"
#   password = ""                 # prefer identityfile
#   config_file = "~/.ssh/config"

#
# Schedules: run a target (a task or "@bundle") on every server, on a cron pattern or once.
# They are checked when the Gorunfile loads. The scheduler runs inside `gorun -serve`.
# See docs/schedules.md.
#

# [[schedule]]
# name = "nightly-backup"         # unique across the Gorunfile and its includes
# description = "Back up the databases"
# target = "@base"                # a task, or "@bundle"
# cron = "0 2 * * *"              # five fields, minute first; set cron or at, not both
# at = "2026-12-01T02:00"         # or one time: RFC 3339, or "2006-01-02T15:04" in timezone
# timezone = "Australia/Sydney"   # IANA name; default UTC
# missed = "skip"                 # skip (default) or run: what to do with runs missed while paused or down
