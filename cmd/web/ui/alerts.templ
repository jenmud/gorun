package ui

templ AlertsPage(d AlertsPageData) {
	if d.Flash != "" {
		@flash(d.Flash, d.FlashBad)
	}
	<div class="mb-6 max-w-2xl">
		<h1 class="text-xl font-semibold text-zinc-100">Alerts</h1>
		<p class="mt-1 text-sm text-zinc-400">Rules from the loaded Gorunfile are checked as each run finishes, using the saved history. Every alert that fires is kept here and published to NATS.</p>
	</div>
	<h2 class="mb-2 text-sm font-semibold text-zinc-200">Rules</h2>
	if len(d.Rules) == 0 {
		<div class="mb-8 rounded-2xl border border-dashed border-zinc-800 p-6 text-center text-sm">
			<p class="text-zinc-200">No alert rules loaded.</p>
			<p class="mt-1 text-zinc-500">Add an <code>[[alerts]]</code> table to the Gorunfile, as shown in the Gorunfile docs.</p>
		</div>
	} else {
		<div class="mb-8 overflow-hidden rounded-2xl border border-zinc-800">
			<table class="w-full text-left text-sm">
				<thead class="bg-zinc-900/60 text-xs uppercase tracking-wider text-zinc-500">
					<tr>
						<th class="px-4 py-2 font-medium">Rule</th>
						<th class="px-4 py-2 font-medium">Kind</th>
						<th class="px-4 py-2 font-medium">Applies to</th>
						<th class="px-4 py-2 font-medium">Fires when</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-zinc-800">
					for _, r := range d.Rules {
						<tr class="transition hover:bg-zinc-900/60">
							<td class="px-4 py-3 font-medium text-zinc-100">{ r.Name }</td>
							<td class="px-4 py-3 text-zinc-400">{ r.Kind }</td>
							<td class="px-4 py-3 font-mono text-xs text-zinc-300">{ r.Target }</td>
							<td class="px-4 py-3 text-zinc-400">{ r.Threshold }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
	<h2 class="mb-2 text-sm font-semibold text-zinc-200">Recent alerts</h2>
	if len(d.Alerts) == 0 {
		<p class="mb-8 text-sm text-zinc-500">No alerts have fired yet.</p>
	} else {
		<div class="mb-8 overflow-hidden rounded-2xl border border-zinc-800">
			<table class="w-full text-left text-sm">
				<thead class="bg-zinc-900/60 text-xs uppercase tracking-wider text-zinc-500">
					<tr>
						<th class="px-4 py-2 font-medium">When</th>
						<th class="px-4 py-2 font-medium">Rule</th>
						<th class="px-4 py-2 font-medium">Task</th>
						<th class="px-4 py-2 font-medium">What happened</th>
						<th class="px-4 py-2 font-medium">Run</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-zinc-800">
					for _, a := range d.Alerts {
						<tr class="transition hover:bg-zinc-900/60">
							<td class="whitespace-nowrap px-4 py-3 text-zinc-400">{ a.When }</td>
							<td class="px-4 py-3 text-zinc-100">{ a.Rule }</td>
							<td class="px-4 py-3 font-mono text-xs text-zinc-300">{ a.Target }</td>
							<td class="px-4 py-3 text-red-200">{ a.Message }</td>
							<td class="px-4 py-3"><a href={ runPath(a.RunID) } class="text-accent hover:underline">open</a></td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
	<h2 class="mb-2 text-sm font-semibold text-zinc-200">Task stats</h2>
	if len(d.Stats) == 0 {
		<p class="text-sm text-zinc-500">No finished tasks in the history yet.</p>
	} else {
		<div class="overflow-hidden rounded-2xl border border-zinc-800">
			<table class="w-full text-left text-sm">
				<thead class="bg-zinc-900/60 text-xs uppercase tracking-wider text-zinc-500">
					<tr>
						<th class="px-4 py-2 font-medium">Task</th>
						<th class="px-4 py-2 text-right font-medium">Runs</th>
						<th class="px-4 py-2 text-right font-medium">Success</th>
						<th class="px-4 py-2 text-right font-medium">Median</th>
						<th class="px-4 py-2 text-right font-medium">p95</th>
						<th class="px-4 py-2 font-medium">Last run</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-zinc-800">
					for _, s := range d.Stats {
						<tr class="transition hover:bg-zinc-900/60">
							<td class="px-4 py-3 font-mono text-xs text-zinc-200">{ s.Target }</td>
							<td class="px-4 py-3 text-right text-zinc-300">{ s.Runs }</td>
							<td class="px-4 py-3 text-right text-zinc-300">{ s.SuccessRate }</td>
							<td class="px-4 py-3 text-right text-zinc-300">{ s.Median }</td>
							<td class="px-4 py-3 text-right text-zinc-300">{ s.P95 }</td>
							if s.LastFailed {
								<td class="px-4 py-3 text-red-300">failed</td>
							} else {
								<td class="px-4 py-3 text-zinc-400">passed</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
