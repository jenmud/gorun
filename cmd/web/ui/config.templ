package ui

import "strings"

templ ConfigPage(d ConfigPageData) {
	if d.Flash != "" {
		@flash(d.Flash, d.FlashBad)
	}
	if d.EditingKind != "" && d.EditingName != "" {
		@editModal(d)
	}
	<div class="mb-6 max-w-3xl">
		<h1 class="text-xl font-semibold text-zinc-100">Config</h1>
		<p class="mt-1 text-sm text-zinc-400">Add, remove and edit the servers, groups, tasks and bundles in your Gorunfile. Changes stay here until you press <span class="font-semibold text-zinc-200">Save</span>, which writes each one back to the file it came from. Comments and layout elsewhere in each file are kept. Runs use the saved file.</p>
	</div>
	<div class="grid gap-6 lg:grid-cols-[1fr_24rem]">
		<div class="min-w-0 space-y-6">
			<section class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-4">
				<h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Files</h2>
				if d.Loaded {
					<ul class="mt-2 space-y-1 font-mono text-xs text-zinc-300">
						for _, f := range d.Files {
							<li>{ f.Label }</li>
						}
					</ul>
				} else {
					<p class="mt-2 text-sm text-zinc-500">No Gorunfile loaded yet. Load one on the right.</p>
				}
			</section>
			@entityTable("Servers", "host", "name", d.Servers)
			@entityTable("Server groups", "group", "name", d.Groups)
			@entityTable("Tasks", "task", "name", d.Tasks)
			@entityTable("Bundles", "bundle", "name", d.Bundles)
		</div>
		<aside class="space-y-6 self-start">
			@pendingPanel(d)
			@filePicker(d.Browser, d.Path)
			if d.Loaded {
				@addServerForm(d.Files)
				@addTaskForm(d.Files)
				@addGroupForm(d.Files)
				@addBundleForm(d.Files)
			}
		</aside>
	</div>
}

templ entityTable(title string, kind string, key string, rows []EntityRow) {
	<section class="rounded-2xl border border-zinc-800 bg-zinc-900/40">
		<header class="flex items-center justify-between border-b border-zinc-800 px-4 py-3">
			<h2 class="text-sm font-semibold text-zinc-100">{ title }</h2>
			<span class="text-xs text-zinc-500">{ itoa(len(rows)) }</span>
		</header>
		if len(rows) == 0 {
			<p class="px-4 py-6 text-center text-sm text-zinc-500">None yet.</p>
		} else {
			<ul class="divide-y divide-zinc-800">
				for _, r := range rows {
					<li class={ entityRowClass(r.Pending) }>
						<div class="min-w-0 flex-1">
							<div class="flex items-center gap-2">
								<span class="truncate font-mono text-sm text-zinc-100">{ r.Name }</span>
								if r.Pending != "" {
									<span class={ pendingBadgeClass(r.Pending) }>{ r.Pending }</span>
								}
							</div>
							<p class="truncate text-xs text-zinc-500">{ r.Detail }</p>
							if r.Source != "" {
								<p class="truncate font-mono text-[11px] text-zinc-600">{ r.Source }</p>
							}
						</div>
						<div class="flex gap-1">
							<a href={ editPath(kind, r.Name) } class="rounded-lg px-2.5 py-1 text-xs text-accent transition hover:bg-violet-950/40">Edit</a>
							<form method="post" action="/config/remove" class="contents">
								<input type="hidden" name="kind" value={ kind }/>
								<input type="hidden" name="name" value={ r.Name }/>
								<button type="submit" class="rounded-lg px-2.5 py-1 text-xs text-red-300 transition hover:bg-red-950/40">Remove</button>
							</form>
						</div>
					</li>
				}
			</ul>
		}
	</section>
}

templ pendingPanel(d ConfigPageData) {
	<section class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-4">
		<h2 class="text-sm font-semibold text-zinc-100">Unsaved changes</h2>
		if len(d.Pending) == 0 {
			<p class="mt-1 text-xs text-zinc-500">None. Adding or removing something above lists it here until you save.</p>
		} else {
			<ul class="mt-2 space-y-1 text-xs text-zinc-300">
				for _, p := range d.Pending {
					<li>• { p }</li>
				}
			</ul>
			<div class="mt-4 flex gap-2">
				<form method="post" action="/config/save" class="flex-1">
					<button class="w-full rounded-lg bg-accent px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-violet-600">Save</button>
				</form>
				<form method="post" action="/config/discard">
					<button class="rounded-lg border border-zinc-700 px-3 py-1.5 text-sm text-zinc-300 transition hover:bg-zinc-800">Discard</button>
				</form>
			</div>
		}
	</section>
}

templ addServerForm(files []FileOption) {
	<details class="group/add rounded-2xl border border-zinc-800 bg-zinc-900/40 p-4">
		<summary class="flex cursor-pointer list-none items-center gap-2 text-sm font-semibold text-zinc-100"><span class="inline-block text-zinc-500 transition group-open/add:rotate-90">▸</span>Add a server</summary>
		<p class="mt-1 text-xs text-zinc-500">Leave the SSH user empty for a server that runs on this machine.</p>
		<form method="post" action="/config/add" class="mt-3 space-y-2">
			<input type="hidden" name="kind" value="host"/>
			<input name="name" required placeholder="name, e.g. web-01" class={ inputClass() }/>
			<input name="hostname" placeholder="hostname (defaults to the name)" class={ inputClass() }/>
			<input name="groups" placeholder="groups, comma separated" class={ inputClass() }/>
			<input name="tags" placeholder="tags, comma separated" class={ inputClass() }/>
			<input name="ssh_user" placeholder="SSH user" class={ inputClass() }/>
			<input name="identityfile" placeholder="identity file, e.g. ~/.ssh/id_ed25519" class={ inputClass() }/>
			@fileSelect(files)
			<button class={ addButtonClass() }>Add server</button>
		</form>
	</details>
}

templ addTaskForm(files []FileOption) {
	<details class="group/add rounded-2xl border border-zinc-800 bg-zinc-900/40 p-4">
		<summary class="flex cursor-pointer list-none items-center gap-2 text-sm font-semibold text-zinc-100"><span class="inline-block text-zinc-500 transition group-open/add:rotate-90">▸</span>Add a task</summary>
		<form method="post" action="/config/add" class="mt-3 space-y-2">
			<input type="hidden" name="kind" value="task"/>
			<input name="name" required placeholder="name, e.g. restart-nginx" class={ inputClass() }/>
			<input name="cmd" required placeholder="command to run" class={ inputClass() }/>
			<input name="description" placeholder="description shown in the picker" class={ inputClass() }/>
			<label class="flex items-center gap-2 text-xs text-zinc-300"><input type="checkbox" name="sudo" class="accent-violet-600"/> run with sudo</label>
			<label class="flex items-center gap-2 text-xs text-zinc-300"><input type="checkbox" name="local" class="accent-violet-600"/> run only on local servers</label>
			@fileSelect(files)
			<button class={ addButtonClass() }>Add task</button>
		</form>
	</details>
}

templ addGroupForm(files []FileOption) {
	<details class="group/add rounded-2xl border border-zinc-800 bg-zinc-900/40 p-4">
		<summary class="flex cursor-pointer list-none items-center gap-2 text-sm font-semibold text-zinc-100"><span class="inline-block text-zinc-500 transition group-open/add:rotate-90">▸</span>Add a server group</summary>
		<p class="mt-1 text-xs text-zinc-500">Settings servers share by joining the group.</p>
		<form method="post" action="/config/add" class="mt-3 space-y-2">
			<input type="hidden" name="kind" value="group"/>
			<input name="name" required placeholder="name, e.g. web" class={ inputClass() }/>
			<input name="tags" placeholder="tags, comma separated" class={ inputClass() }/>
			<input name="tasks" placeholder="tasks or @bundles, comma separated" class={ inputClass() }/>
			<input name="ssh_user" placeholder="SSH user" class={ inputClass() }/>
			<input name="identityfile" placeholder="identity file" class={ inputClass() }/>
			@fileSelect(files)
			<button class={ addButtonClass() }>Add group</button>
		</form>
	</details>
}

templ addBundleForm(files []FileOption) {
	<details class="group/add rounded-2xl border border-zinc-800 bg-zinc-900/40 p-4">
		<summary class="flex cursor-pointer list-none items-center gap-2 text-sm font-semibold text-zinc-100"><span class="inline-block text-zinc-500 transition group-open/add:rotate-90">▸</span>Add a bundle</summary>
		<p class="mt-1 text-xs text-zinc-500">A named list of tasks. Use it as <span class="font-mono">{ "@name" }</span> anywhere a task list goes.</p>
		<form method="post" action="/config/add" class="mt-3 space-y-2">
			<input type="hidden" name="kind" value="bundle"/>
			<input name="name" required placeholder="name, e.g. baseline" class={ inputClass() }/>
			<input name="tasks" required placeholder="tasks, comma separated" class={ inputClass() }/>
			<input name="description" placeholder="description" class={ inputClass() }/>
			@fileSelect(files)
			<button class={ addButtonClass() }>Add bundle</button>
		</form>
	</details>
}

templ fileSelect(files []FileOption) {
	<label class="block text-xs text-zinc-400">
		Save into
		<select name="file" class={ inputClass() }>
			for _, f := range files {
				<option value={ f.Path }>{ f.Label }</option>
			}
		</select>
	</label>
}

// filePicker browses the folders of the machine running gorun and loads the Gorunfile picked.
templ filePicker(b Browser, current string) {
	<section id="load" class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-4">
		<h2 class="text-sm font-semibold text-zinc-100">Load a Gorunfile</h2>
		<p class="mt-1 text-xs text-zinc-500">Pick a file on the machine running gorun. Unsaved changes are dropped when you load.</p>
		<div class="mt-3 flex items-center gap-2">
			if b.Parent != "" {
				<a href={ browsePath(b.Parent) } title="Up one folder" class="rounded-md border border-zinc-700 bg-zinc-800 px-2 py-1 text-xs text-zinc-300 hover:bg-zinc-700">↑</a>
			}
			<span class="min-w-0 truncate font-mono text-xs text-zinc-300" title={ b.Dir }>{ b.Dir }</span>
		</div>
		<input type="search" placeholder="Filter this folder" oninput="gorunFilter(this, 'picker-list')" class={ inputClass() + " mt-2" }/>
		if b.Err != "" {
			<p class="mt-2 text-xs text-red-300">{ b.Err }</p>
		}
		<ul id="picker-list" class="mt-2 max-h-72 divide-y divide-zinc-800/60 overflow-auto rounded-lg border border-zinc-800 bg-zinc-950 text-xs">
			if len(b.Entries) == 0 && b.Err == "" {
				<li class="px-3 py-2 text-zinc-500">This folder is empty.</li>
			}
			for _, e := range b.Entries {
				<li data-filter={ strings.ToLower(e.Name) }>
					if e.Dir {
						<a href={ browsePath(e.Path) } class="flex items-center gap-2 px-3 py-1.5 text-zinc-300 hover:bg-zinc-800/60">
							<span class="text-zinc-500">▸</span>
							<span class="truncate font-mono">{ e.Name }/</span>
						</a>
					} else {
						<form method="post" action="/config/load">
							<input type="hidden" name="path" value={ e.Path }/>
							<button class={ pickerFileClass(e.Likely, e.Path == current) } title={ "Load " + e.Path }>
								<span class={ pickerIconClass(e.Likely) }>≡</span>
								<span class="truncate font-mono">{ e.Name }</span>
								if e.Path == current {
									<span class="ml-auto text-[10px] uppercase text-accent">loaded</span>
								}
							</button>
						</form>
					}
				</li>
			}
		</ul>
		<details class="mt-3">
			<summary class="cursor-pointer text-xs text-zinc-500 hover:text-zinc-300">Type a path instead</summary>
			<form method="post" action="/config/load" class="mt-2 space-y-2">
				<input name="path" required value={ current } placeholder="/path/to/Gorunfile" class={ inputClass() }/>
				<button class={ addButtonClass() }>Load</button>
			</form>
		</details>
	</section>
}

templ editModal(d ConfigPageData) {
	<div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4">
		<div class="max-h-[90vh] w-full max-w-2xl overflow-auto rounded-2xl border border-zinc-800 bg-zinc-900 p-6">
			<h2 class="text-lg font-semibold text-zinc-100">Edit { kindLabel(d.EditingKind) } <span class="font-mono">{ d.EditingName }</span></h2>
			<p class="mt-1 text-xs text-zinc-500">Settings not shown here are kept as they are. Clear a field to remove it. The change is queued until you press Save.</p>
			<form method="post" action="/config/edit" class="mt-4 space-y-3">
				<input type="hidden" name="kind" value={ d.EditingKind }/>
				<input type="hidden" name="name" value={ d.EditingName }/>
				switch d.EditingKind {
					case "host":
						@editField("Hostname", "hostname", d.Edit.Hostname, "defaults to the name")
						@editField("Groups", "groups", d.Edit.Groups, "comma separated")
						@editField("Tags", "tags", d.Edit.Tags, "comma separated")
						@editField("SSH user", "ssh_user", d.Edit.SSHUser, "")
						@editField("Identity file", "identityfile", d.Edit.IdentityFile, "e.g. ~/.ssh/id_ed25519")
					case "task":
						<label class="block text-xs text-zinc-400">
							Command
							<textarea name="cmd" rows="4" placeholder="leave empty if the task uses cmd_file, a template or only copies files" class={ inputClass() + " font-mono" }>{ d.Edit.Cmd }</textarea>
						</label>
						@editField("Description", "description", d.Edit.Description, "")
						<label class="flex items-center gap-2 text-xs text-zinc-300"><input type="checkbox" name="sudo" checked?={ d.Edit.Sudo } class="accent-violet-600"/> run with sudo</label>
						<label class="flex items-center gap-2 text-xs text-zinc-300"><input type="checkbox" name="local" checked?={ d.Edit.Local } class="accent-violet-600"/> run only on local servers</label>
					case "group":
						@editField("Tags", "tags", d.Edit.Tags, "comma separated")
						@editField("Tasks", "tasks", d.Edit.Tasks, "tasks or @bundles, comma separated")
						@editField("SSH user", "ssh_user", d.Edit.SSHUser, "")
						@editField("Identity file", "identityfile", d.Edit.IdentityFile, "")
					case "bundle":
						@editField("Tasks", "tasks", d.Edit.Tasks, "tasks or @bundles, comma separated")
						@editField("Description", "description", d.Edit.Description, "")
				}
				<div class="flex gap-2 pt-2">
					<button type="submit" class="flex-1 rounded-lg bg-accent px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-violet-600">Update</button>
					<a href="/config" class="rounded-lg border border-zinc-700 px-3 py-1.5 text-sm text-zinc-300 transition hover:bg-zinc-800">Cancel</a>
				</div>
			</form>
		</div>
	</div>
}

templ editField(label, name, value, placeholder string) {
	<label class="block text-xs text-zinc-400">
		{ label }
		<input name={ name } value={ value } placeholder={ placeholder } class={ inputClass() }/>
	</label>
}
