package ui

templ ConfigPage(d ConfigPageData) {
	if d.Flash != "" {
		@flash(d.Flash, d.FlashBad)
	}
	<div class="mb-6 max-w-3xl">
		<h1 class="text-xl font-semibold text-zinc-100">Config</h1>
		<p class="mt-1 text-sm text-zinc-400">Add, edit and remove the servers, groups, tasks and bundles in your Gorunfile. Changes stay here until you press <span class="font-semibold text-zinc-200">Save</span>, which writes each one back to the file it came from. Comments and layout elsewhere in each file are kept. Runs use the saved file.</p>
	</div>
	<div class="grid gap-6 lg:grid-cols-[1fr_24rem]">
		<div class="min-w-0 space-y-6">
			<section class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-4">
				<h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Files</h2>
				if d.Loaded {
					<ul class="mt-2 space-y-1 font-mono text-xs text-zinc-300">
						for _, f := range d.Files {
							<li>{ f.Label }</li>
						}
					</ul>
				} else {
					<p class="mt-2 text-sm text-zinc-500">No Gorunfile loaded yet. Load one on the right.</p>
				}
			</section>
			@entityTable("Servers", "host", "Add server", d.Servers, d.Loaded)
			@entityTable("Server groups", "group", "Add group", d.Groups, d.Loaded)
			@entityTable("Tasks", "task", "Add task", d.Tasks, d.Loaded)
			@entityTable("Bundles", "bundle", "Add bundle", d.Bundles, d.Loaded)
		</div>
		<aside class="space-y-6 self-start">
			@pendingPanel(d)
			<section class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-4">
				<h2 class="text-sm font-semibold text-zinc-100">Load a Gorunfile</h2>
				<p class="mt-1 text-xs text-zinc-500">A path on the machine running gorun. Unsaved changes are dropped when you load.</p>
				<form method="post" action="/config/load" class="mt-3 space-y-2">
					<input name="path" required value={ d.Path } placeholder="/path/to/Gorunfile" class={ inputClass() }/>
					<button class="w-full rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-1.5 text-sm text-zinc-200 transition hover:bg-zinc-700">Load</button>
				</form>
			</section>
		</aside>
	</div>
	if d.Loaded {
		@serverDialog(d)
		@groupDialog(d)
		@taskDialog(d)
		@bundleDialog(d)
	}
	if d.Draft.Mode != "" {
		<script>
document.querySelectorAll('dialog[data-open]').forEach(function (d) { d.showModal(); });
		</script>
	}
}

templ entityTable(title string, kind string, addLabel string, rows []EntityRow, loaded bool) {
	<section class="rounded-2xl border border-zinc-800 bg-zinc-900/40">
		<header class="flex items-center justify-between gap-3 border-b border-zinc-800 px-4 py-3">
			<h2 class="text-sm font-semibold text-zinc-100">{ title }</h2>
			<div class="flex items-center gap-3">
				<span class="text-xs text-zinc-500">{ itoa(len(rows)) }</span>
				if loaded {
					<a href={ modalPath("add", kind, "") } class="rounded-lg border border-zinc-700 bg-zinc-800 px-2.5 py-1 text-xs text-zinc-200 transition hover:bg-zinc-700">{ addLabel }</a>
				}
			</div>
		</header>
		if len(rows) == 0 {
			<p class="px-4 py-6 text-center text-sm text-zinc-500">None yet.</p>
		} else {
			<ul class="divide-y divide-zinc-800">
				for _, r := range rows {
					@entityItem(kind, r)
				}
			</ul>
		}
	</section>
}

templ entityItem(kind string, r EntityRow) {
	<li class={ entityRowClass(r.Pending) }>
		<div class="min-w-0 flex-1">
			<div class="flex items-center gap-2">
				<span class="truncate font-mono text-sm text-zinc-100">{ r.Name }</span>
				if r.Pending != "" {
					<span class={ pendingBadgeClass(r.Pending) }>{ r.Pending }</span>
				}
			</div>
			<p class="truncate text-xs text-zinc-500">{ r.Detail }</p>
			if len(r.Chips) > 0 {
				<div class="mt-1 flex flex-wrap gap-1">
					for _, c := range r.Chips {
						<span class="rounded-full bg-zinc-800 px-2 py-0.5 font-mono text-[11px] text-zinc-300">{ c }</span>
					}
				</div>
			}
			if r.Source != "" {
				<p class="truncate font-mono text-[11px] text-zinc-600">{ r.Source }</p>
			}
		</div>
		<div class="flex shrink-0 items-center gap-1">
			if r.Pending != "remove" {
				<a href={ modalPath("edit", kind, r.Name) } class="rounded-lg px-2.5 py-1 text-xs text-zinc-300 transition hover:bg-zinc-800">Edit</a>
			}
			<form method="post" action="/config/remove">
				<input type="hidden" name="kind" value={ kind }/>
				<input type="hidden" name="name" value={ r.Name }/>
				<button class="rounded-lg px-2.5 py-1 text-xs text-red-300 transition hover:bg-red-950/40">Remove</button>
			</form>
		</div>
	</li>
}

templ pendingPanel(d ConfigPageData) {
	<section class="rounded-2xl border border-zinc-800 bg-zinc-900/40 p-4">
		<h2 class="text-sm font-semibold text-zinc-100">Unsaved changes</h2>
		if len(d.Pending) == 0 {
			<p class="mt-1 text-xs text-zinc-500">None. Adding, editing or removing something here lists it until you save.</p>
		} else {
			<ul class="mt-2 space-y-1 text-xs text-zinc-300">
				for _, p := range d.Pending {
					<li>• { p }</li>
				}
			</ul>
			<div class="mt-4 flex gap-2">
				<form method="post" action="/config/save" class="flex-1">
					<button class="w-full rounded-lg bg-accent px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-violet-600">Save</button>
				</form>
				<form method="post" action="/config/discard">
					<button class="rounded-lg border border-zinc-700 px-3 py-1.5 text-sm text-zinc-300 transition hover:bg-zinc-800">Discard</button>
				</form>
			</div>
		}
	</section>
}

templ serverDialog(d ConfigPageData) {
	<dialog class={ dialogClass() } data-open?={ dialogOpen(d.Draft, "host") }>
		<form method="post" action={ dialogAction(d.Draft) } class="space-y-4 p-6">
			<input type="hidden" name="kind" value="host"/>
			<h2 class="text-base font-semibold text-zinc-100">{ dialogTitle(d.Draft, "server") }</h2>
			<p class="text-xs text-zinc-500">Leave the SSH user empty for a server that runs on this machine.</p>
			@nameField(d.Draft, "e.g. web-01")
			<label class="block text-xs text-zinc-400">
				Hostname
				<input name="hostname" value={ d.Draft.Hostname } placeholder="defaults to the name" class={ inputClass() }/>
			</label>
			<label class="block text-xs text-zinc-400">
				Tags, comma separated
				<input name="tags" value={ d.Draft.Tags } class={ inputClass() }/>
			</label>
			@choices("groups", "Server groups", d.GroupChoices, "No server groups yet.")
			@sshFields(d.Draft)
			@fileField(d)
			@dialogFooter(dialogSubmit(d.Draft, "server"))
		</form>
	</dialog>
}

templ groupDialog(d ConfigPageData) {
	<dialog class={ dialogClass() } data-open?={ dialogOpen(d.Draft, "group") }>
		<form method="post" action={ dialogAction(d.Draft) } class="space-y-4 p-6">
			<input type="hidden" name="kind" value="group"/>
			<h2 class="text-base font-semibold text-zinc-100">{ dialogTitle(d.Draft, "server group") }</h2>
			<p class="text-xs text-zinc-500">Settings servers share by joining the group. Tick the servers that belong to it; they are added to or taken out of the group when you save.</p>
			@nameField(d.Draft, "e.g. web")
			<label class="block text-xs text-zinc-400">
				Tags, comma separated
				<input name="tags" value={ d.Draft.Tags } class={ inputClass() }/>
			</label>
			@choices("tasks", "Tasks and bundles", d.ListChoices, "No tasks yet.")
			@choices("servers", "Servers in this group", d.ServerChoices, "No servers yet.")
			@sshFields(d.Draft)
			@fileField(d)
			@dialogFooter(dialogSubmit(d.Draft, "server group"))
		</form>
	</dialog>
}

templ taskDialog(d ConfigPageData) {
	<dialog class={ dialogClass() } data-open?={ dialogOpen(d.Draft, "task") }>
		<form method="post" action={ dialogAction(d.Draft) } class="space-y-4 p-6">
			<input type="hidden" name="kind" value="task"/>
			<h2 class="text-base font-semibold text-zinc-100">{ dialogTitle(d.Draft, "task") }</h2>
			@nameField(d.Draft, "e.g. restart-nginx")
			<label class="block text-xs text-zinc-400">
				Command
				<input name="cmd" value={ d.Draft.Cmd } placeholder="command to run" class={ inputClass() }/>
			</label>
			<label class="block text-xs text-zinc-400">
				Description
				<input name="description" value={ d.Draft.Description } placeholder="shown in the picker" class={ inputClass() }/>
			</label>
			<label class="flex items-center gap-2 text-xs text-zinc-300"><input type="checkbox" name="sudo" checked?={ d.Draft.Sudo } class="accent-violet-600"/> run with sudo</label>
			<label class="flex items-center gap-2 text-xs text-zinc-300"><input type="checkbox" name="local" checked?={ d.Draft.Local } class="accent-violet-600"/> run only on local servers</label>
			@choices("depends_on", "Depends on", d.DependChoices, "No other tasks yet. A task can depend on tasks that run before it.")
			@fileField(d)
			@dialogFooter(dialogSubmit(d.Draft, "task"))
		</form>
	</dialog>
}

templ bundleDialog(d ConfigPageData) {
	<dialog class={ dialogClass() } data-open?={ dialogOpen(d.Draft, "bundle") }>
		<form method="post" action={ dialogAction(d.Draft) } class="space-y-4 p-6">
			<input type="hidden" name="kind" value="bundle"/>
			<h2 class="text-base font-semibold text-zinc-100">{ dialogTitle(d.Draft, "bundle") }</h2>
			<p class="text-xs text-zinc-500">A named list of tasks. Use it as <span class="font-mono">@name</span> anywhere a task list goes.</p>
			@nameField(d.Draft, "e.g. baseline")
			<label class="block text-xs text-zinc-400">
				Description
				<input name="description" value={ d.Draft.Description } class={ inputClass() }/>
			</label>
			@choices("tasks", "Tasks", d.ListChoices, "No tasks yet.")
			@fileField(d)
			@dialogFooter(dialogSubmit(d.Draft, "bundle"))
		</form>
	</dialog>
}

templ nameField(d Draft, placeholder string) {
	<label class="block text-xs text-zinc-400">
		Name
		<input name="name" required value={ d.Name } readonly?={ d.Mode == "edit" } placeholder={ placeholder } class={ inputClass() }/>
	</label>
}

templ sshFields(d Draft) {
	<div class="grid grid-cols-2 gap-3">
		<label class="block text-xs text-zinc-400">
			SSH user
			<input name="ssh_user" value={ d.SSHUser } class={ inputClass() }/>
		</label>
		<label class="block text-xs text-zinc-400">
			Identity file
			<input name="identityfile" value={ d.IdentityFile } placeholder="~/.ssh/id_ed25519" class={ inputClass() }/>
		</label>
	</div>
}

templ choices(name string, label string, items []Choice, none string) {
	<fieldset class="space-y-2">
		<legend class="text-xs font-semibold uppercase tracking-wider text-zinc-400">{ label }</legend>
		if len(items) == 0 {
			<p class="text-xs text-zinc-500">{ none }</p>
		}
		<div class="flex flex-wrap gap-2">
			for _, c := range items {
				<label class={ chipPickClass(c.Checked) }>
					<input type="checkbox" name={ name } value={ c.Value } checked?={ c.Checked } class="accent-violet-600"/>
					<span class="font-mono">{ c.Label }</span>
				</label>
			}
		</div>
	</fieldset>
}

templ fileField(d ConfigPageData) {
	if d.Draft.Mode == "edit" {
		<input type="hidden" name="file" value={ d.Draft.File }/>
	} else {
		<label class="block text-xs text-zinc-400">
			Save into
			<select name="file" class={ inputClass() }>
				for _, f := range d.Files {
					<option value={ f.Path }>{ f.Label }</option>
				}
			</select>
		</label>
	}
}

templ dialogFooter(submit string) {
	<div class="flex justify-end gap-2 pt-2">
		<a href="/config" class="rounded-lg border border-zinc-700 px-3 py-1.5 text-sm text-zinc-300 hover:bg-zinc-800">Cancel</a>
		<button class="rounded-lg bg-accent px-4 py-1.5 text-sm font-semibold text-white hover:bg-violet-600">{ submit }</button>
	</div>
}
