package ui

templ Dashboard(s DashboardState) {
	if len(s.ProcessOrder) == 0 {
		<div class="rounded-2xl border border-dashed border-zinc-800 p-10 text-center text-sm">
			<p class="text-zinc-200">Nothing running.</p>
			<p class="mt-1 text-zinc-500">Pick servers and tasks on the left, then press <span class="font-semibold text-accent">Run</span>. Runs started from the terminal show up here too.</p>
		</div>
	}
	if hasFinished(s) {
		<div class="mb-3 flex justify-end">
			<button data-on:click="@post('/clear')" class="rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-1.5 text-xs text-zinc-300 transition hover:bg-zinc-700">Clear finished</button>
		</div>
	}
	for _, uuid := range s.ProcessOrder {
		@processCard(s.Processes[uuid])
	}
}

templ processCard(p *ProcessState) {
	<section class={ runCardClass(processHasFailed(p), p.Finished) }>
		<header class="flex flex-wrap items-center gap-3 p-4">
			<div class="min-w-0 flex-1">
				<div class="flex items-center gap-2">
					<span class={ runStateClass(p) }>{ runStateLabel(p) }</span>
					<h3 class="truncate font-semibold text-zinc-100">{ p.Title }</h3>
				</div>
				<p class="mt-1 truncate font-mono text-xs text-zinc-500">{ p.UUID }</p>
			</div>
			<div class="flex items-center gap-4 text-xs text-zinc-400">
				<span>{ itoa(processDone(p)) }/{ itoa(processTotal(p)) } tasks</span>
				if p.Finished {
					<span>{ processDuration(p) }</span>
				}
			</div>
			if !p.Finished {
				<form method="post" action={ runCancelPath(p.UUID) }>
					<button class="rounded-lg border border-red-900/60 px-3 py-1.5 text-xs text-red-300 transition hover:bg-red-950/40">Stop</button>
				</form>
			}
		</header>
		<div class="h-1 w-full bg-zinc-800">
			<div class={ progressClass(processHasFailed(p)) } style={ "width: " + itoa(processProgress(p)) + "%" }></div>
		</div>
		<div class="grid gap-3 p-4 md:grid-cols-2">
			for _, sname := range p.ServerOrder {
				@serverBlock(p.Servers[sname])
			}
		</div>
	</section>
}

templ serverBlock(srv *ServerInfo) {
	<div class={ serverBoxClass(serverHasFailed(srv)) }>
		<div class="mb-2 flex items-baseline justify-between gap-2">
			<span class={ serverNameClass(serverHasFailed(srv)) }>{ srv.Name }</span>
			<span class="font-mono text-xs text-zinc-500">{ srv.Address }</span>
		</div>
		<div class="mb-3 h-1 w-full overflow-hidden rounded bg-zinc-800">
			<div class={ progressClass(serverHasFailed(srv)) } style={ "width: " + itoa(serverProgress(srv)) + "%" }></div>
		</div>
		<ul class="space-y-1">
			for _, tname := range srv.Order {
				@taskRow(srv.Tasks[tname])
			}
		</ul>
	</div>
}

templ taskRow(t *TaskInfo) {
	<li class="rounded-lg px-2 py-1 transition hover:bg-zinc-800/40">
		<details open?={ t.State == 3 }>
			<summary class="flex cursor-pointer list-none items-center gap-2 text-sm">
				<span class={ stateClass(t.State) }>{ stateIcon(t.State) }</span>
				<span class="font-mono text-zinc-200">{ t.Name }</span>
				if t.Attempts > 1 {
					<span class="text-xs text-amber-400">attempt { itoa(t.Attempt) }/{ itoa(t.Attempts) }</span>
				}
				<span class="ml-auto text-xs text-zinc-500">{ taskTiming(t) }</span>
			</summary>
			<div class="mt-2 space-y-2 border-l border-zinc-800 pl-3 text-xs">
				<p class="text-zinc-400">{ hintFor(t.State) }</p>
				if t.Description != "" {
					<p class="text-zinc-300">{ t.Description }</p>
				}
				if t.Details != "" {
						<p class="text-zinc-400">{ t.Details }</p>
					}
					if t.Rerun != "" {
						<p class="text-amber-400">{ rerunLabel(t.Rerun) }</p>
					}
					if t.Command != "" {
					<pre class="overflow-x-auto rounded-lg bg-zinc-950 p-2 font-mono text-zinc-300">$ { t.Command }</pre>
				}
				if t.Stdout != "" {
					<pre class="max-h-64 overflow-auto rounded-lg bg-zinc-950 p-2 font-mono text-zinc-300">{ t.Stdout }</pre>
				}
				if t.Stderr != "" {
					<pre class="max-h-64 overflow-auto rounded-lg bg-zinc-950 p-2 font-mono text-red-300">{ t.Stderr }</pre>
				}
				if t.State == 3 {
					<p class="text-red-300">exit code { itoa(t.ExitCode) }</p>
				}
			</div>
		</details>
	</li>
}
