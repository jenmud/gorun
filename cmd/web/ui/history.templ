package ui

import "github.com/jenmud/gorun/internal/store"

templ HistoryPage(d HistoryPageData) {
	if d.Flash != "" {
		@flash(d.Flash, false)
	}
	<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
		<div class="max-w-2xl">
			<h1 class="text-xl font-semibold text-zinc-100">History</h1>
			<p class="mt-1 text-sm text-zinc-400">Every run is saved here with the commands it ran and what they printed. Open a run to see each server's tasks, how long they took, and their output. Failed tasks are marked in red with their exit code.</p>
		</div>
		<form method="post" action="/runs/truncate" class="flex items-center gap-3 text-xs text-zinc-400">
			<span>Keep only the newest 10 runs</span>
			<button class="rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-1.5 text-zinc-200 transition hover:bg-zinc-700">Trim history</button>
		</form>
	</div>
	if len(d.Runs) == 0 {
		<div class="rounded-2xl border border-dashed border-zinc-800 p-10 text-center text-sm">
			<p class="text-zinc-200">No runs saved yet.</p>
			<p class="mt-1 text-zinc-500">Start one from <a href="/" class="text-accent hover:underline">Run</a>. It will appear here as soon as it starts.</p>
		</div>
	} else {
		<div class="overflow-hidden rounded-2xl border border-zinc-800">
			<table class="w-full text-left text-sm">
				<thead class="bg-zinc-900/60 text-xs uppercase tracking-wider text-zinc-500">
					<tr>
						<th class="px-4 py-2 font-medium">Status</th>
						<th class="px-4 py-2 font-medium">Run</th>
						<th class="px-4 py-2 font-medium">Started</th>
						<th class="px-4 py-2 text-right font-medium">Took</th>
						<th class="px-4 py-2 text-right font-medium">Servers</th>
						<th class="px-4 py-2 text-right font-medium">Tasks</th>
						<th class="px-4 py-2 text-right font-medium">Failed</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-zinc-800">
					for _, r := range d.Runs {
						@historyRow(r)
					}
				</tbody>
			</table>
		</div>
	}
}

templ historyRow(r RunRow) {
	<tr class="transition hover:bg-zinc-900/60">
		<td class="px-4 py-3"><span class={ runBadgeClass(r.State) }>{ runBadgeLabel(r.State) }</span></td>
		<td class="px-4 py-3">
			<a href={ runPath(r.ID) } class="font-medium text-zinc-100 hover:text-accent">{ r.Title }</a>
			if r.Schedule != "" || r.CheckOnly {
				<div class="mt-1 flex flex-wrap gap-1">
					if r.Schedule != "" {
						@scheduleBadge(r.Schedule)
					}
					if r.CheckOnly {
						@checkOnlyBadge()
					}
				</div>
			}
			if r.Origin != nil {
				@originLine(r.Origin)
			} else {
				<div class="font-mono text-xs text-zinc-500">{ r.Hostname }</div>
			}
		</td>
		<td class="px-4 py-3 text-zinc-400">{ startedText(r) }</td>
		<td class="px-4 py-3 text-right font-mono text-xs text-zinc-300">{ formatDuration(r.Duration) }</td>
		<td class="px-4 py-3 text-right text-zinc-300">{ itoa(r.Servers) }</td>
		<td class="px-4 py-3 text-right text-zinc-300">{ itoa(r.TotalTasks) }</td>
		<td class="px-4 py-3 text-right">
			if r.Failed > 0 {
				<span class="text-red-400">{ itoa(r.Failed) }</span>
			} else {
				<span class="text-zinc-500">0</span>
			}
		</td>
	</tr>
}

templ HistoryDetailPage(d RunDetailData) {
	<div class="mb-4 text-xs">
		<a href="/history" class="text-zinc-400 hover:text-zinc-200">← back to history</a>
	</div>
	<header class="mb-6 flex flex-wrap items-start justify-between gap-4">
		<div class="min-w-0">
			<div class="flex items-center gap-3">
				<span class={ runBadgeClass(d.Summary.State) }>{ runBadgeLabel(d.Summary.State) }</span>
				<h1 class="truncate text-xl font-semibold text-zinc-100">{ d.Summary.Title }</h1>
				if d.Summary.Schedule != "" {
					@scheduleBadge(d.Summary.Schedule)
				}
				if d.Summary.CheckOnly {
					@checkOnlyBadge()
				}
			</div>
			<p class="mt-1 font-mono text-xs text-zinc-500">{ d.Summary.ID }</p>
			<p class="mt-1 text-sm text-zinc-400">Started { startedText(d.Summary) } { runWhere(d.Summary) }</p>
			@originLine(d.Summary.Origin)
		</div>
		<form method="post" action={ deletePath(d.Summary.ID) }>
			<button class="rounded-lg border border-red-900/60 px-3 py-1.5 text-xs text-red-300 transition hover:bg-red-950/40">Delete this run</button>
		</form>
	</header>
	<div class="mb-6 grid grid-cols-2 gap-3 md:grid-cols-4">
		@statTile("Took", formatDuration(d.Summary.Duration), "wall clock")
		@statTile("Tasks", itoa(d.Summary.TotalTasks), itoa(d.Summary.Servers)+" servers")
		@statTile("Failed", itoa(d.Summary.Failed), "tasks that exited non-zero or errored")
		@statTile("Skipped", itoa(d.Summary.Skipped), "because a dependency failed")
	</div>
	if d.Summary.Origin != nil {
		<div class="mb-6">
			@originPanel(d.Summary.Origin)
		</div>
	}
	if len(d.Run.RunEnvVars) > 0 || len(d.Run.RunVars) > 0 {
		<div class="mb-6">
			@varsPanel("Run", d.Run.RunEnvVars, d.Run.RunVars)
		</div>
	}
	if len(d.Run.Includes) > 0 {
		<section class="mb-6 rounded-xl border border-zinc-800 bg-zinc-900/40 p-4">
			<h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Task libraries</h2>
			<p class="mt-1 text-xs text-zinc-500">The git includes this run read, and the commit each one used.</p>
			<ul class="mt-2 space-y-1">
				for _, inc := range d.Run.Includes {
					<li class="flex flex-wrap items-baseline gap-x-2 font-mono text-xs">
						<span class="text-zinc-200">{ inc.Source }</span>
						<span class="text-zinc-500">{ "@ " + inc.Ref }</span>
						<span class="text-zinc-300" title={ inc.Commit }>{ shortCommit(inc.Commit) }</span>
					</li>
				}
			</ul>
		</section>
	}
	<p class="mb-4 text-sm text-zinc-400">Tasks are listed slowest first. Open a task to see the command it ran, what it printed, its exit code and the variables it saw. Errors from a server that couldn't be reached are listed at the top of its card.</p>
	<div class="space-y-4">
		for _, srv := range d.Servers {
			@historyServer(srv)
		}
	</div>
}

templ historyServer(srv ServerBlock) {
	<section class={ runCardClass(srv.Failed, true) }>
		<header class="flex flex-wrap items-baseline justify-between gap-2 p-4">
			<div>
				<span class={ serverNameClass(srv.Failed) }>{ srv.Name }</span>
				<span class="ml-2 font-mono text-xs text-zinc-500">{ srv.Address }</span>
			</div>
			<span class="text-xs text-zinc-400">{ itoa(len(srv.Tasks)) } tasks · { formatDuration(srv.Duration) }</span>
		</header>
		if srv.Error != "" {
			<div class="border-t border-zinc-800 p-3">
				@errorBox("Could not run on this server", srv.Error, notRunNote(len(srv.Tasks)))
			</div>
		}
		if len(srv.EnvVars) > 0 || len(srv.Vars) > 0 {
			<div class="border-t border-zinc-800 px-4 py-3">
				@varsPanel("Server", srv.EnvVars, srv.Vars)
			</div>
		}
		<ul class="space-y-1 border-t border-zinc-800 p-3">
			for _, t := range srv.Tasks {
				@historyTask(t)
			}
		</ul>
	</section>
}

templ historyTask(t TaskView) {
	<li class="rounded-lg transition hover:bg-zinc-800/30">
		<details open?={ t.State == 3 } data-on:toggle__once={ taskLoad(t) }>
			<summary class="flex cursor-pointer list-none items-center gap-2 px-2 py-1.5 text-sm">
				<span class={ taskViewClass(t) }>{ taskViewIcon(t) }</span>
				<a href={ taskHref(t.Name) } class="font-mono text-zinc-200 hover:text-accent underline decoration-zinc-600 underline-offset-2 hover:decoration-accent">{ t.Name }</a>
				<span class={ taskViewClass(t) + " text-xs" }>{ taskViewLabel(t) }</span>
				if t.State == 3 {
					<span class="rounded bg-red-500/15 px-1.5 py-0.5 font-mono text-[11px] text-red-300 ring-1 ring-red-500/40">exit { itoa(t.ExitCode) }</span>
				}
				if !t.NotRun {
					<span class="ml-auto font-mono text-xs text-zinc-500">{ formatDuration(t.Duration) }</span>
				}
			</summary>
			<div id={ t.ID } class="px-2 pb-3">
				if t.Loaded {
					@taskInspector(t)
				} else {
					<p class="py-2 text-xs text-zinc-500">Loading…</p>
				}
			</div>
		</details>
	</li>
}

// taskInspector is everything saved about one task: its outcome, command, output and variables.
templ taskInspector(t TaskView) {
	<div class="mt-1 space-y-3 border-l-2 border-zinc-800 pl-3 text-xs">
		if t.State == 3 {
			@errorBox("Failed with exit code "+itoa(t.ExitCode), failureReason(t), "")
		}
		<dl class="grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-4">
			@fact("Status") {
				<span class={ taskViewClass(t) }>{ taskViewIcon(t) } { taskViewLabel(t) }</span>
			}
			@fact("Exit code") {
				if !t.NotRun && (t.State == 2 || t.State == 3 || t.State == 5 || t.State == 6) {
					<span class={ exitClass(t.ExitCode) }>{ itoa(t.ExitCode) }</span>
				} else {
					<span class="text-zinc-500">—</span>
				}
			}
			@fact("Duration") {
				<span class="font-mono text-zinc-200">{ formatDuration(t.Duration) }</span>
			}
			@fact("Server") {
				<span class="font-mono text-zinc-200">{ t.Server }</span>
				if t.Address != "" {
					<span class="font-mono text-zinc-500"> { t.Address }</span>
				}
			}
		</dl>
		<p class="text-zinc-400">{ taskViewHint(t, t.ServerFailed) }</p>
		if t.Check != nil {
			@stepFolds("", "Check", t.Check)
		}
		@fold("", "Command", "") {
			if t.Command != "" {
				<pre class="overflow-x-auto whitespace-pre-wrap break-all rounded-lg bg-zinc-950 p-2 font-mono text-zinc-200">$ { t.Command }</pre>
			} else {
				<p class="text-zinc-500">Not recorded.</p>
			}
		}
		@fold("", "Stdout", lineCount(t.Stdout)) {
			if t.Stdout != "" {
				<pre class="max-h-96 overflow-auto rounded-lg bg-zinc-950 p-2 font-mono text-zinc-300">{ t.Stdout }</pre>
			} else {
				<p class="text-zinc-500">No output.</p>
			}
		}
		@fold("", "Stderr", lineCount(t.Stderr)) {
			if t.Stderr != "" {
				<pre class="max-h-96 overflow-auto rounded-lg bg-zinc-950 p-2 font-mono text-red-300">{ t.Stderr }</pre>
			} else {
				<p class="text-zinc-500">No output.</p>
			}
		}
		if t.Verify != nil {
			@stepFolds("", "Verify", t.Verify)
		}
		@varsPanel("Task", t.EnvVars, t.Vars)
	</div>
}

// stepFolds shows a check or verify like the task's own command and output: its command, its
// stdout and its stderr, each in its own drop-down.
templ stepFolds(key, title string, s *store.Step) {
	@fold(foldKey(key, "cmd"), title+" command", stepSummary(s)) {
		<pre class="overflow-x-auto whitespace-pre-wrap break-all rounded-lg bg-zinc-950 p-2 font-mono text-zinc-200">$ { s.Command }</pre>
	}
	@fold(foldKey(key, "out"), title+" stdout", lineCount(s.Stdout)) {
		if s.Stdout != "" {
			<pre class="max-h-96 overflow-auto rounded-lg bg-zinc-950 p-2 font-mono text-zinc-300">{ s.Stdout }</pre>
		} else {
			<p class="text-zinc-500">No output.</p>
		}
	}
	@fold(foldKey(key, "err"), title+" stderr", lineCount(s.Stderr)) {
		if s.Stderr != "" {
			<pre class="max-h-96 overflow-auto rounded-lg bg-zinc-950 p-2 font-mono text-red-300">{ s.Stderr }</pre>
		} else {
			<p class="text-zinc-500">No output.</p>
		}
	}
}

// checkOnlyBadge marks a check-only run, which changed nothing.
templ checkOnlyBadge() {
	<span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-amber-500/10 px-2 py-0.5 text-[11px] font-medium text-amber-300 ring-1 ring-amber-500/40" title="Only checks ran: nothing was changed">check only</span>
}

templ fact(label string) {
	<div>
		<dt class="text-[11px] uppercase tracking-wider text-zinc-500">{ label }</dt>
		<dd class="mt-0.5">{ children... }</dd>
	</div>
}

// varsPanel lists the env vars and vars captured at one scope: the run, a server or a task. Both
// start collapsed.
templ varsPanel(scope string, env map[string]string, vars map[string]any) {
	<div class="grid gap-3 md:grid-cols-2">
		@fold("", scope+" env vars", countLabel(len(env))) {
			if len(env) == 0 {
				<p class="text-xs text-zinc-500">None recorded.</p>
			} else {
				<div class="max-h-64 overflow-auto rounded-lg bg-zinc-950">
					<table class="w-full font-mono text-xs">
						for _, kv := range envPairs(env) {
							<tr class="border-b border-zinc-900 last:border-0">
								<td class="whitespace-nowrap px-2 py-1 align-top text-violet-300">{ kv.Key }</td>
								<td class="break-all px-2 py-1 text-zinc-300">{ kv.Value }</td>
							</tr>
						}
					</table>
				</div>
			}
		}
		@fold("", scope+" vars", countLabel(len(vars))) {
			if len(vars) == 0 {
				<p class="text-xs text-zinc-500">None recorded.</p>
			} else {
				<pre class="max-h-64 overflow-auto rounded-lg bg-zinc-950 p-2 font-mono text-xs text-zinc-300">{ varsJSON(vars) }</pre>
			}
		}
	</div>
}

// fold is a labelled section that starts collapsed. key, when set, lets the live page keep it
// open across updates.
templ fold(key, label, hint string) {
	<details { foldAttrs(key)... } class="group/fold min-w-0">
		<summary class="flex cursor-pointer list-none items-baseline gap-2">
			<span class="inline-block text-zinc-500 transition group-open/fold:rotate-90">▸</span>
			<span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">{ label }</span>
			if hint != "" {
				<span class="text-[11px] text-zinc-600">{ hint }</span>
			}
		</summary>
		<div class="mt-1">
			{ children... }
		</div>
	</details>
}

// scheduleBadge marks a run a schedule started, and links to that schedule.
templ scheduleBadge(name string) {
	<a href={ scheduleHref(name) } title={ "Started by the schedule " + name + ". Open it on the Schedules page." } class="inline-flex shrink-0 items-center gap-1 rounded-full bg-sky-500/10 px-2 py-0.5 text-[11px] font-medium text-sky-300 ring-1 ring-sky-500/40 underline decoration-sky-500/40 underline-offset-2 transition hover:bg-sky-500/20 hover:text-sky-200" data-schedule={ name }>
		<span aria-hidden="true">⏱</span> scheduled · { name }
	</a>
}
