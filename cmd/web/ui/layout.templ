package ui

// nats says how the page reaches NATS: the header shows the mode and address, or why it is off.
templ Layout(title string, active string, nats NATSStatus, body templ.Component) {
	<!doctype html>
	<html lang="en" class="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } · gorun</title>
			<script src="https://cdn.tailwindcss.com"></script>
			<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@1.0.0-RC.8/bundles/datastar.js"></script>
			<script>
				tailwind.config = {
					darkMode: 'class',
					theme: {
						extend: {
							colors: { accent: '#7C3AED' },
							fontFamily: {
								sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
								mono: ['ui-monospace', 'SFMono-Regular', 'Menlo', 'monospace'],
							},
						},
					},
				}
			</script>
			<script>
// A task picker shows its comma separated field as labels, with the tasks and bundles to pick
// from below them; the field stays the one the form posts.
function gorunTaskPicker(root) {
	var field = root.querySelector('[data-picker-value]');
	var chips = root.querySelector('[data-picker-chips]');
	var empty = root.querySelector('[data-picker-empty]');
	var search = root.querySelector('[data-picker-search]');
	var options = root.querySelectorAll('[data-picker-option]');
	var required = field.required;
	var picked = field.value.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
	field.required = false;
	field.hidden = true;
	root.querySelector('[data-picker-ui]').hidden = false;
	function render() {
		field.value = picked.join(', ');
		chips.querySelectorAll('[data-chip]').forEach(function (c) { c.remove(); });
		empty.hidden = picked.length > 0;
		picked.forEach(function (name, i) {
			var chip = document.createElement('span');
			chip.dataset.chip = name;
			var bundle = name.charAt(0) === '@';
			chip.className = 'inline-flex items-center gap-1 rounded-md px-2 py-0.5 font-mono text-xs ' +
				(bundle ? 'bg-sky-500/15 text-sky-200 ring-1 ring-sky-500/30' : 'bg-accent/20 text-violet-100 ring-1 ring-accent/40');
			chip.appendChild(document.createTextNode(name));
			var x = document.createElement('button');
			x.type = 'button';
			x.className = 'text-zinc-400 hover:text-white';
			x.setAttribute('aria-label', 'Remove ' + name);
			x.textContent = '×';
			x.onclick = function () { picked.splice(i, 1); render(); };
			chip.appendChild(x);
			chips.insertBefore(chip, empty);
		});
		options.forEach(function (o) {
			var on = picked.indexOf(o.dataset.pickerOption) !== -1;
			o.disabled = on;
			o.classList.toggle('opacity-40', on);
		});
	}
	options.forEach(function (o) {
		o.onclick = function () {
			if (picked.indexOf(o.dataset.pickerOption) === -1) { picked.push(o.dataset.pickerOption); }
			chips.classList.remove('border-red-500');
			render();
		};
	});
	search.oninput = function () {
		var terms = search.value.toLowerCase().split(/\s+/).filter(Boolean);
		options.forEach(function (o) {
			var ok = terms.every(function (t) { return o.dataset.pickerOption.toLowerCase().indexOf(t) !== -1; });
			o.parentElement.style.display = ok ? '' : 'none';
		});
	};
	search.onkeydown = function (ev) {
		if (ev.key === 'Escape') { search.value = ''; search.oninput(); }
		if (ev.key === 'Enter') {
			ev.preventDefault(); // pick the first match instead of submitting the form
			var first = Array.prototype.find.call(options, function (o) { return o.parentElement.style.display !== 'none' && !o.disabled; });
			if (first) { first.click(); search.value = ''; search.oninput(); }
		}
	};
	root.closest('form').addEventListener('submit', function (ev) {
		if (required && picked.length === 0) {
			ev.preventDefault();
			chips.classList.add('border-red-500');
			empty.textContent = 'Pick at least one task or bundle.';
			search.focus();
		}
	});
	render();
}
document.addEventListener('DOMContentLoaded', function () {
	document.querySelectorAll('[data-task-picker]').forEach(gorunTaskPicker);
});
function gorunFilter(input, listId) {
	// every word typed must appear in a row, so "deploy sudo" finds sudo tasks about deploys
	var terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
	var rows = document.querySelectorAll('#' + listId + ' [data-filter]');
	var shown = 0;
	rows.forEach(function (row) {
		var ok = terms.every(function (t) { return row.dataset.filter.indexOf(t) !== -1; });
		row.style.display = ok ? '' : 'none';
		if (ok) shown++;
	});
	var count = document.getElementById(listId + '-count');
	if (count) count.textContent = terms.length ? shown + ' of ' + rows.length + ' shown' : '';
}
// esc in a filter box clears it and shows every row again
function gorunFilterKey(event, input, listId) {
	if (event.key === 'Escape') { input.value = ''; gorunFilter(input, listId); }
}
// Sections on the live page rebuild with every event. Remember which ones the person opened and
// reopen them after each update.
(function () {
	var open = new Set();
	try { JSON.parse(sessionStorage.getItem('gorunOpen') || '[]').forEach(function (k) { open.add(k); }); } catch (e) {}
	function save() { try { sessionStorage.setItem('gorunOpen', JSON.stringify(Array.from(open))); } catch (e) {} }
	document.addEventListener('click', function (ev) {
		var sum = ev.target.closest && ev.target.closest('summary');
		var d = sum && sum.parentElement;
		if (!d || !d.dataset.key) { return; }
		if (d.open) { open.delete(d.dataset.key); } else { open.add(d.dataset.key); }
		save();
	});
	function restore() {
		document.querySelectorAll('details[data-key]:not([data-key=""])').forEach(function (d) {
			var want = open.has(d.dataset.key);
			if (d.open !== want) { d.open = want; }
		});
	}
	document.addEventListener('DOMContentLoaded', restore);
	new MutationObserver(restore).observe(document.documentElement, { childList: true, subtree: true, attributes: true, attributeFilter: ['open'] });
})();
// Opening a task or bundle link expands that item and scrolls to it.
function gorunOpenHash() {
	var id = decodeURIComponent(location.hash.slice(1));
	var el = id ? document.getElementById(id) : null;
	if (!el) { return; }
	var card = el.querySelector(':scope > details');
	if (card) { card.open = true; }
	el.classList.add('ring-2', 'ring-accent', 'bg-accent/10');
	setTimeout(function () { el.classList.remove('ring-2', 'ring-accent', 'bg-accent/10'); }, 2000);
	el.scrollIntoView({ block: 'center' });
}
document.addEventListener('DOMContentLoaded', gorunOpenHash);
window.addEventListener('hashchange', gorunOpenHash);
// Tasks and bundles can't be run together: ticking one clears the other list.
function gorunExclusive(box, otherId) {
	if (!box.checked) { return; }
	document.querySelectorAll('#' + otherId + ' input[type=checkbox]').forEach(function (b) { b.checked = false; });
}
function gorunSelect(formId, on) {
	document.querySelectorAll('#' + formId + ' [data-filter]').forEach(function (row) {
		if (row.style.display === 'none') { return; }
		var box = row.querySelector('input[type=checkbox]');
		if (box) { box.checked = on; }
	});
}
			</script>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
		</head>
		<body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased selection:bg-accent/30">
			<header class="border-b border-zinc-800 bg-zinc-900/80 backdrop-blur">
				<div class="mx-auto flex max-w-7xl flex-wrap items-center gap-4 px-6 py-3">
					<span class="rounded bg-accent px-2 py-0.5 text-sm font-bold text-white">gorun</span>
					<nav class="flex flex-wrap gap-1 text-sm">
						@navLink("/", "Live", active == "live")
						if !noGorunfile(ctx) {
							@navLink("/run", "Run", active == "run")
							@navLink("/tasks", "Tasks", active == "tasks")
							@navLink("/bundles", "Bundles", active == "bundles")
							@navLink("/schedules", "Schedules", active == "schedules")
						}
						@navLink("/history", "History", active == "history")
						if !noGorunfile(ctx) {
							@navLink("/config", "Config", active == "config")
						}
						@navLink("/assistant", "Assistant", active == "assistant")
						if v := viewer(ctx); v.Admin && v.Users {
							@navLink("/users", "Users", active == "users")
						}
						if name, ok := storedName(ctx); ok {
							@navLink("/gorunfiles", "Gorunfiles", active == "gorunfiles")
							if name != "" {
								<a href="/gorunfiles" title="The open Gorunfile, kept in the history database" class="self-center rounded bg-zinc-800 px-2 py-0.5 font-mono text-xs text-zinc-300 hover:bg-zinc-700">{ name }</a>
							}
						}
					</nav>
					if nats.Mode != "off" {
						<span class="ml-auto flex items-center gap-2 text-xs text-emerald-400" title={ "NATS is " + natsModeLabel(nats.Mode) }>
							<span class="h-2 w-2 animate-pulse rounded-full bg-emerald-400"></span>
							live
							<span class="rounded bg-zinc-800 px-1.5 py-0.5 text-zinc-300">{ nats.Mode }</span>
							<span class="font-mono text-zinc-400">{ nats.URL }</span>
						</span>
					} else {
						<span class="ml-auto text-xs text-amber-400">NATS is off ({ nats.Reason }): runs and live updates are off</span>
					}
					if v := viewer(ctx); v.LoginOn && v.User != "" {
						<span class="flex items-center gap-2 text-xs text-zinc-400">
							signed in as <span class="font-mono text-zinc-200">{ v.User }</span>
							if !v.Proxy {
								<form method="post" action="/logout"><button class="underline underline-offset-2 hover:text-white">Sign out</button></form>
							}
						</span>
					} else if v.LoginOn {
						<a href={ templ.SafeURL("/login?" + loginQuery(v.Path)) } class="rounded border border-zinc-700 px-2 py-0.5 text-xs text-zinc-200 hover:bg-zinc-800">Sign in</a>
					}
					<a href="https://github.com/jenmud/gorun" target="_blank" rel="noopener noreferrer" class="text-xs text-zinc-400 underline underline-offset-2 hover:text-white">GitHub</a>
				</div>
			</header>
			<main class="mx-auto max-w-7xl px-6 py-6">
				@body
			</main>
		</body>
	</html>
}

templ navLink(href string, label string, on bool) {
	<a href={ href } class={ navClass(on) }>{ label }</a>
}
