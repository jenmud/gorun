package ui

// nats says how the page reaches NATS: the header shows the mode and address, or why it is off.
templ Layout(title string, active string, nats NATSStatus, body templ.Component) {
	<!doctype html>
	<html lang="en" class="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } · gorun</title>
			<script src="https://cdn.tailwindcss.com"></script>
			<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@1.0.0-RC.8/bundles/datastar.js"></script>
			<script>
				tailwind.config = {
					darkMode: 'class',
					theme: {
						extend: {
							colors: { accent: '#7C3AED' },
							fontFamily: {
								sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
								mono: ['ui-monospace', 'SFMono-Regular', 'Menlo', 'monospace'],
							},
						},
					},
				}
			</script>
			<script>
function gorunFilter(input, listId) {
	var q = input.value.toLowerCase();
	document.querySelectorAll('#' + listId + ' [data-filter]').forEach(function (row) {
		row.style.display = row.dataset.filter.indexOf(q) === -1 ? 'none' : '';
	});
}
// Sections on the live page rebuild with every event. Remember which ones the person opened and
// reopen them after each update.
(function () {
	var open = new Set();
	try { JSON.parse(sessionStorage.getItem('gorunOpen') || '[]').forEach(function (k) { open.add(k); }); } catch (e) {}
	function save() { try { sessionStorage.setItem('gorunOpen', JSON.stringify(Array.from(open))); } catch (e) {} }
	document.addEventListener('click', function (ev) {
		var sum = ev.target.closest && ev.target.closest('summary');
		var d = sum && sum.parentElement;
		if (!d || !d.dataset.key) { return; }
		if (d.open) { open.delete(d.dataset.key); } else { open.add(d.dataset.key); }
		save();
	});
	function restore() {
		document.querySelectorAll('details[data-key]:not([data-key=""])').forEach(function (d) {
			var want = open.has(d.dataset.key);
			if (d.open !== want) { d.open = want; }
		});
	}
	document.addEventListener('DOMContentLoaded', restore);
	new MutationObserver(restore).observe(document.documentElement, { childList: true, subtree: true, attributes: true, attributeFilter: ['open'] });
})();
// Opening a task or bundle link expands that item and scrolls to it.
function gorunOpenHash() {
	var id = decodeURIComponent(location.hash.slice(1));
	var el = id ? document.getElementById(id) : null;
	if (!el) { return; }
	var card = el.querySelector(':scope > details');
	if (card) { card.open = true; }
	el.classList.add('ring-2', 'ring-accent', 'bg-accent/10');
	setTimeout(function () { el.classList.remove('ring-2', 'ring-accent', 'bg-accent/10'); }, 2000);
	el.scrollIntoView({ block: 'center' });
}
document.addEventListener('DOMContentLoaded', gorunOpenHash);
window.addEventListener('hashchange', gorunOpenHash);
// Tasks and bundles can't be run together: ticking one clears the other list.
function gorunExclusive(box, otherId) {
	if (!box.checked) { return; }
	document.querySelectorAll('#' + otherId + ' input[type=checkbox]').forEach(function (b) { b.checked = false; });
}
function gorunSelect(formId, on) {
	document.querySelectorAll('#' + formId + ' [data-filter]').forEach(function (row) {
		if (row.style.display === 'none') { return; }
		var box = row.querySelector('input[type=checkbox]');
		if (box) { box.checked = on; }
	});
}
			</script>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
		</head>
		<body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased selection:bg-accent/30">
			<header class="border-b border-zinc-800 bg-zinc-900/80 backdrop-blur">
				<div class="mx-auto flex max-w-7xl flex-wrap items-center gap-4 px-6 py-3">
					<span class="rounded bg-accent px-2 py-0.5 text-sm font-bold text-white">gorun</span>
					<nav class="flex gap-1 text-sm">
						@navLink("/", "Run", active == "run")
						@navLink("/tasks", "Tasks", active == "tasks")
						@navLink("/bundles", "Bundles", active == "bundles")
						@navLink("/schedules", "Schedules", active == "schedules")
						@navLink("/history", "History", active == "history")
						@navLink("/config", "Config", active == "config")
					</nav>
					if nats.Mode != "off" {
						<span class="ml-auto flex items-center gap-2 text-xs text-emerald-400" title={ "NATS is " + natsModeLabel(nats.Mode) }>
							<span class="h-2 w-2 animate-pulse rounded-full bg-emerald-400"></span>
							live
							<span class="rounded bg-zinc-800 px-1.5 py-0.5 text-zinc-300">{ nats.Mode }</span>
							<span class="font-mono text-zinc-400">{ nats.URL }</span>
						</span>
					} else {
						<span class="ml-auto text-xs text-amber-400">NATS is off ({ nats.Reason }): runs and live updates are off</span>
					}
					<a href="https://github.com/jenmud/gorun" target="_blank" rel="noopener noreferrer" class="text-xs text-zinc-400 underline underline-offset-2 hover:text-white">GitHub</a>
				</div>
			</header>
			<main class="mx-auto max-w-7xl px-6 py-6">
				@body
			</main>
		</body>
	</html>
}

templ navLink(href string, label string, on bool) {
	<a href={ href } class={ navClass(on) }>{ label }</a>
}
