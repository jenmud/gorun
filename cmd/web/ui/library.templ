package ui

templ notLoaded() {
	<div class="rounded-2xl border border-dashed border-zinc-800 p-10 text-center text-sm">
		<p class="text-zinc-200">No Gorunfile loaded.</p>
		<p class="mt-1 text-zinc-500">Load one on the <a href="/config" class="text-accent hover:underline">Config</a> page.</p>
	</div>
}

templ TasksPage(d TasksPageData) {
	<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
		<div class="max-w-2xl">
			<h1 class="text-xl font-semibold text-zinc-100">Tasks</h1>
			<p class="mt-1 text-sm text-zinc-400">Every task in your Gorunfile. Open one to see what it runs, how it is set up, what it depends on and where it runs. Sorted slowest first by average time in recent runs; tasks that have not run yet come last.</p>
		</div>
		if d.Loaded {
			<input type="search" placeholder="Filter tasks" oninput="gorunFilter(this, 'task-cards')" class={ inputClass() + " max-w-xs" }/>
		}
	</div>
	@pageNotes(d.Notice, d.Error)
	if d.EditingName != "" {
		@taskEditPanel(d)
	}
	if !d.Loaded {
		@notLoaded()
	} else {
		@taskAddForm(d.Files)
		if len(d.Tasks) == 0 {
			<p class="text-sm text-zinc-500">This Gorunfile defines no tasks.</p>
		} else {
			<ul id="task-cards" class="space-y-2">
				for _, t := range d.Tasks {
					@taskCard(t)
				}
			</ul>
		}
	}
}

// pageNotes shows the outcome of a form on the page: a confirmation, or what went wrong.
templ pageNotes(notice string, errMsg string) {
	if notice != "" {
		<p class="mb-4 rounded-lg border border-emerald-900 bg-emerald-950/40 px-4 py-2 text-sm text-emerald-300">{ notice }</p>
	}
	if errMsg != "" {
		<p class="mb-4 rounded-lg border border-red-900 bg-red-950/40 px-4 py-2 text-sm text-red-300">{ errMsg }</p>
	}
}

templ taskAddForm(files []FileOption) {
	<details class="group/add mb-4 rounded-2xl border border-zinc-800 bg-zinc-900/40 p-4">
		<summary class="flex cursor-pointer list-none items-center gap-2 text-sm font-semibold text-zinc-100"><span class="inline-block text-zinc-500 transition group-open/add:rotate-90">▸</span>Add a task</summary>
		<p class="mt-1 text-xs text-zinc-500">The task is saved to its file straight away.</p>
		<form method="post" action="/tasks/add" class="mt-3 grid gap-2 sm:grid-cols-2">
			<input name="name" required placeholder="name, e.g. restart-web" class={ inputClass() }/>
			<input name="description" placeholder="description" class={ inputClass() }/>
			<textarea name="cmd" required rows="3" placeholder="command, e.g. systemctl restart web" class={ inputClass() + " font-mono sm:col-span-2" }></textarea>
			@taskCheckFields(EditFields{}, false)
			<label class="flex items-center gap-2 text-xs text-zinc-300"><input type="checkbox" name="sudo" class="accent-violet-600"/> run with sudo</label>
			<label class="flex items-center gap-2 text-xs text-zinc-300"><input type="checkbox" name="local" class="accent-violet-600"/> run only on local servers</label>
			<div class="sm:col-span-2">
				@fileSelect(files)
			</div>
			<div class="sm:col-span-2">
				<button class={ addButtonClass() }>Add task</button>
			</div>
		</form>
	</details>
}

// taskCheckFields are a task's check and verify in its add and edit forms. The edit form also
// offers check_copies, so editing a task never drops it; a new task from a form copies nothing.
templ taskCheckFields(e EditFields, edit bool) {
	<label class="block text-xs text-zinc-400 sm:col-span-2">
		Check <span class="text-zinc-600">runs first: exit 0 means nothing to do, so the task is skipped as unchanged</span>
		<input name="check" value={ e.Check } placeholder="e.g. dpkg -s nginx (leave empty: the task always runs)" class={ inputClass() + " font-mono" }/>
	</label>
	<label class="block text-xs text-zinc-400 sm:col-span-2">
		Verify <span class="text-zinc-600">runs after the command: a non-zero exit fails the task</span>
		<input name="verify" value={ e.Verify } placeholder="e.g. systemctl is-active nginx" class={ inputClass() + " font-mono" }/>
	</label>
	if edit {
		<label class="flex items-center gap-2 text-xs text-zinc-300 sm:col-span-2"><input type="checkbox" name="check_copies" checked?={ e.CheckCopies } class="accent-violet-600"/> check copies: skip the task when the server already has every file it copies (MD5)</label>
	}
}

templ taskEditPanel(d TasksPageData) {
	<section class="mb-6 rounded-2xl border border-zinc-800 bg-zinc-900/60 p-5">
		<h2 class="text-lg font-semibold text-zinc-100">Edit task <span class="font-mono">{ d.EditingName }</span></h2>
		<p class="mt-1 text-xs text-zinc-500">The change is written to the file it came from straight away. Settings not shown here are kept.</p>
		<form method="post" action="/tasks/edit" class="mt-4 space-y-3">
			<input type="hidden" name="name" value={ d.EditingName }/>
			<label class="block text-xs text-zinc-400">
				Command
				<textarea name="cmd" rows="4" placeholder="leave empty if the task uses cmd_file, a template or only copies files" class={ inputClass() + " font-mono" }>{ d.Edit.Cmd }</textarea>
			</label>
			@taskCheckFields(d.Edit, true)
			@editField("Description", "description", d.Edit.Description, "")
			<label class="flex items-center gap-2 text-xs text-zinc-300"><input type="checkbox" name="sudo" checked?={ d.Edit.Sudo } class="accent-violet-600"/> run with sudo</label>
			<label class="flex items-center gap-2 text-xs text-zinc-300"><input type="checkbox" name="local" checked?={ d.Edit.Local } class="accent-violet-600"/> run only on local servers</label>
			<div class="flex gap-2">
				<button type="submit" class="rounded-lg bg-accent px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-violet-600">Save task</button>
				<a href="/tasks" class="rounded-lg border border-zinc-700 px-3 py-1.5 text-sm text-zinc-300 transition hover:bg-zinc-800">Cancel</a>
			</div>
		</form>
	</section>
}

// pageEditPath opens a page with one of its items in the edit panel.
templ pageEditLink(page string, name string) {
	<a href={ pageEditPath(page, name) } class="rounded-lg px-2.5 py-1 text-xs text-accent transition hover:bg-violet-950/40">Edit</a>
}

templ taskCard(t TaskCard) {
	<li id={ "task-" + t.Name } data-filter={ taskFilter(t) } class="rounded-xl border border-zinc-800 bg-zinc-900/40">
		<details class="group/task">
			<summary class="flex cursor-pointer list-none flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
				<span class="inline-block text-zinc-500 transition group-open/task:rotate-90">▸</span>
				<span class="font-mono text-sm font-semibold text-zinc-100">{ t.Name }</span>
				if t.Description != "" {
					<span class="min-w-0 flex-1 truncate text-sm text-zinc-400">{ t.Description }</span>
				}
				for _, b := range t.Badges {
					<span class="rounded bg-zinc-800 px-1.5 py-0.5 text-[11px] text-zinc-300">{ b }</span>
				}
				if t.Average > 0 {
					<span class="ml-auto font-mono text-xs text-zinc-400" title="Average over recent runs">avg { formatDuration(t.Average) }</span>
				}
			</summary>
			<div class="space-y-4 border-t border-zinc-800 px-4 py-4 text-xs">
				if t.Details != "" {
					<p class="text-sm text-zinc-300">{ t.Details }</p>
				}
				@pageEditLink("/tasks", t.Name)
				<details class="group/cmd">
					<summary class="flex cursor-pointer list-none items-center gap-2">
						<span class="inline-block text-zinc-500 transition group-open/cmd:rotate-90">▸</span>
						<span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Command</span>
						<span class="font-mono text-[11px] text-zinc-600">{ t.CommandSource }</span>
					</summary>
					<pre class="mt-2 max-h-80 overflow-auto whitespace-pre-wrap break-all rounded-lg bg-zinc-950 p-2 font-mono text-zinc-200">{ t.Command }</pre>
				</details>
				@cardStep("Check", cardCheck(t), "runs first: exit 0 means nothing to do, so the task is skipped as unchanged", "none: the task always runs")
				@cardStep("Verify", t.Verify, "runs after the command: a non-zero exit fails the task", "none")
				if len(t.Options) > 0 {
					<details class="group/opts">
						<summary class="flex cursor-pointer list-none items-center gap-2">
							<span class="inline-block text-zinc-500 transition group-open/opts:rotate-90">▸</span>
							<span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Options</span>
						</summary>
						<dl class="mt-2 grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-3 lg:grid-cols-5">
							for _, o := range t.Options {
								<div>
									<dt class="text-[11px] uppercase tracking-wider text-zinc-500">{ o.Name }</dt>
									<dd class="mt-0.5 font-mono text-zinc-200">{ o.Value }</dd>
								</div>
							}
						</dl>
					</details>
				}
				@refRow("Depends on", t.DependsOn, "none", false)
				@refRow("In bundles", t.InBundles, "none", true)
				@linkRow("Runs on", runsOn(t.RunsOn), "no server runs it")
				if len(t.Files) > 0 {
					<details class="group/files">
						<summary class="flex cursor-pointer list-none items-center gap-2">
							<span class="inline-block text-zinc-500 transition group-open/files:rotate-90">▸</span>
							<span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Referenced files</span>
						</summary>
						<ul class="mt-2 space-y-1 text-[11px]">
							for _, f := range t.Files {
								<li class="rounded bg-zinc-800/40 px-2 py-1">
									<div class="text-zinc-500">{ f.Type }</div>
									<a href={ filePath(f.Path) } target="_blank" class="font-mono text-accent hover:underline break-all">{ f.Path }</a>
								</li>
							}
						</ul>
					</details>
				}
				@varsPanel("Task", t.EnvVars, t.Vars)
				if len(t.ConfigVars) > 0 {
					<details class="group/cfgvars">
						<summary class="flex cursor-pointer list-none items-center gap-2">
							<span class="inline-block text-zinc-500 transition group-open/cfgvars:rotate-90">▸</span>
							<span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Config vars</span>
						</summary>
						<pre class="mt-2 max-h-64 overflow-auto rounded-lg bg-zinc-950 p-2 font-mono text-zinc-300">{ varsJSON(t.ConfigVars) }</pre>
					</details>
				}
				if t.Source != "" {
					<p class="font-mono text-zinc-600">Defined in { t.Source }</p>
				}
			</div>
		</details>
	</li>
}

// linkRow is a labelled list of names, or what to say when there are none.
// refRow lists task names, or bundle names when bundles is set, each linking to its card.
templ refRow(label string, items []string, none string, bundles bool) {
	<div class="flex flex-wrap items-baseline gap-2">
		<span class="w-20 shrink-0 text-[11px] font-semibold uppercase tracking-wider text-zinc-500">{ label }</span>
		if len(items) == 0 {
			<span class="text-zinc-500">{ none }</span>
		}
		for _, it := range items {
			if bundles {
				<a href={ bundleHref(it) } class="rounded bg-zinc-800 px-1.5 py-0.5 font-mono text-zinc-300 underline underline-offset-2 hover:bg-zinc-700 hover:text-white">{ it }</a>
			} else {
				<a href={ taskHref(it) } class="rounded bg-zinc-800 px-1.5 py-0.5 font-mono text-zinc-300 underline underline-offset-2 hover:bg-zinc-700 hover:text-white">{ it }</a>
			}
		}
	</div>
}

// taskLink and refLink link a task, or a "@bundle" reference, to where it is defined.
templ refLink(ref string, class string) {
	<a href={ refHref(ref) } class={ class }>{ ref }</a>
}

templ linkRow(label string, items []string, none string) {
	<div class="flex flex-wrap items-baseline gap-2">
		<span class="w-20 shrink-0 text-[11px] font-semibold uppercase tracking-wider text-zinc-500">{ label }</span>
		if len(items) == 0 {
			<span class="text-zinc-500">{ none }</span>
		}
		for _, it := range items {
			<span class="rounded bg-zinc-800 px-1.5 py-0.5 font-mono text-zinc-300">{ it }</span>
		}
	</div>
}

templ BundlesPage(d BundlesPageData) {
	<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
		<div class="max-w-2xl">
			<h1 class="text-xl font-semibold text-zinc-100">Bundles</h1>
			<p class="mt-1 text-sm text-zinc-400">A bundle is a named list of tasks, written <span class="font-mono">{ "@name" }</span> wherever a task list goes. Open one to see its tasks in order and everything it expands to.</p>
		</div>
		if d.Loaded {
			<input type="search" placeholder="Filter bundles" oninput="gorunFilter(this, 'bundle-cards')" class={ inputClass() + " max-w-xs" }/>
		}
	</div>
	@pageNotes(d.Notice, d.Error)
	if d.EditingName != "" {
		@bundleEditPanel(d)
	}
	if !d.Loaded {
		@notLoaded()
	} else {
		@bundleAddForm(d.Files, d.Targets)
		if len(d.Bundles) == 0 {
			<p class="text-sm text-zinc-500">This Gorunfile defines no bundles.</p>
		} else {
			<ul id="bundle-cards" class="space-y-2">
				for _, b := range d.Bundles {
					@bundleCard(b)
				}
			</ul>
		}
	}
}

templ bundleAddForm(files []FileOption, targets []string) {
	<details class="group/add mb-4 rounded-2xl border border-zinc-800 bg-zinc-900/40 p-4">
		<summary class="flex cursor-pointer list-none items-center gap-2 text-sm font-semibold text-zinc-100"><span class="inline-block text-zinc-500 transition group-open/add:rotate-90">▸</span>Add a bundle</summary>
		<p class="mt-1 text-xs text-zinc-500">A named list of tasks. The bundle is saved to its file straight away.</p>
		<form method="post" action="/bundles/add" class="mt-3 grid gap-2 sm:grid-cols-2">
			<input name="name" required placeholder="name, e.g. baseline" class={ inputClass() }/>
			<input name="description" placeholder="description" class={ inputClass() }/>
			<input name="tasks" required list="bundle-targets" placeholder="tasks or @bundles, comma separated" class={ inputClass() + " sm:col-span-2" }/>
			<datalist id="bundle-targets">
				for _, t := range targets {
					<option value={ t }></option>
				}
			</datalist>
			<div class="sm:col-span-2">
				@fileSelect(files)
			</div>
			<div class="sm:col-span-2">
				<button class={ addButtonClass() }>Add bundle</button>
			</div>
		</form>
	</details>
}

templ bundleEditPanel(d BundlesPageData) {
	<section class="mb-6 rounded-2xl border border-zinc-800 bg-zinc-900/60 p-5">
		<h2 class="text-lg font-semibold text-zinc-100">Edit bundle <span class="font-mono">{ "@" + d.EditingName }</span></h2>
		<p class="mt-1 text-xs text-zinc-500">The change is written to the file it came from straight away. Settings not shown here are kept.</p>
		<form method="post" action="/bundles/edit" class="mt-4 space-y-3">
			<input type="hidden" name="name" value={ d.EditingName }/>
			@editField("Tasks", "tasks", d.Edit.Tasks, "tasks or @bundles, comma separated")
			@editField("Description", "description", d.Edit.Description, "")
			<div class="flex gap-2">
				<button type="submit" class="rounded-lg bg-accent px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-violet-600">Save bundle</button>
				<a href="/bundles" class="rounded-lg border border-zinc-700 px-3 py-1.5 text-sm text-zinc-300 transition hover:bg-zinc-800">Cancel</a>
			</div>
		</form>
	</section>
}

templ bundleCard(b BundleCard) {
	<li id={ "bundle-" + b.Name } data-filter={ bundleFilter(b) } class="rounded-xl border border-zinc-800 bg-zinc-900/40">
		<details class="group/bundle">
			<summary class="flex cursor-pointer list-none flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
				<span class="inline-block text-zinc-500 transition group-open/bundle:rotate-90">▸</span>
				<span class="font-mono text-sm font-semibold text-zinc-100">{ "@" + b.Name }</span>
				if b.Description != "" {
					<span class="min-w-0 flex-1 truncate text-sm text-zinc-400">{ b.Description }</span>
				}
				<span class="ml-auto text-xs text-zinc-400">{ itoa(len(b.Expanded)) } tasks</span>
			</summary>
			<div class="space-y-4 border-t border-zinc-800 px-4 py-4 text-xs">
				@pageEditLink("/bundles", b.Name)
				<details class="group/items">
					<summary class="flex cursor-pointer list-none items-center gap-2">
						<span class="inline-block text-zinc-500 transition group-open/items:rotate-90">▸</span>
						<span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Tasks in bundle</span>
					</summary>
					<ol class="mt-2 divide-y divide-zinc-800/60 rounded-lg border border-zinc-800 bg-zinc-950">
						for i, it := range b.Items {
							<li class="flex items-baseline gap-3 px-3 py-1.5">
								<span class="w-5 text-right font-mono text-zinc-600">{ itoa(i+1) }</span>
								@refLink(it.Ref, "font-mono text-zinc-100 hover:text-accent underline decoration-zinc-600 underline-offset-2 hover:decoration-accent")
								if it.IsBundle {
									<span class="rounded bg-violet-500/15 px-1.5 py-0.5 text-[10px] uppercase text-violet-300">bundle</span>
								}
								<span class="min-w-0 truncate text-zinc-500">{ it.Description }</span>
							</li>
						}
					</ol>
				</details>
				@refRow("Expands to", b.Expanded, "no tasks", false)
				@refRow("Used by", b.UsedBy, "no other bundle", true)
				if len(b.Vars) > 0 {
					<details class="group/bvars">
						<summary class="flex cursor-pointer list-none items-center gap-2">
							<span class="inline-block text-zinc-500 transition group-open/bvars:rotate-90">▸</span>
							<span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Bundle vars</span>
						</summary>
						<pre class="mt-2 max-h-64 overflow-auto rounded-lg bg-zinc-950 p-2 font-mono text-zinc-300">{ varsJSON(b.Vars) }</pre>
					</details>
				}
				<div class="flex items-center justify-between gap-3">
					if b.Source != "" {
						<p class="font-mono text-zinc-600">Defined in { b.Source }</p>
					}
					<a href={ runBundlePath(b.Name) } class="rounded-lg bg-accent px-3 py-1.5 font-semibold text-white transition hover:bg-violet-600">Run this bundle</a>
				</div>
			</div>
		</details>
	</li>
}

// cardStep is a task's check or verify on its card: folded like the command, with what it does
// beside it; or that the task has none.
templ cardStep(label, command, about, none string) {
	if command == "" {
		<p class="flex items-center gap-2"><span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">{ label }</span><span class="text-zinc-500">{ none }</span></p>
	} else {
		<details class="group/step">
			<summary class="flex cursor-pointer list-none items-center gap-2">
				<span class="inline-block text-zinc-500 transition group-open/step:rotate-90">▸</span>
				<span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">{ label }</span>
				<span class="text-[11px] text-zinc-600">{ about }</span>
			</summary>
			<pre class="mt-2 max-h-60 overflow-auto whitespace-pre-wrap break-all rounded-lg bg-zinc-950 p-2 font-mono text-zinc-200">{ command }</pre>
		</details>
	}
}
