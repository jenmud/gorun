package ui

templ notLoaded() {
	<div class="rounded-2xl border border-dashed border-zinc-800 p-10 text-center text-sm">
		<p class="text-zinc-200">No Gorunfile loaded.</p>
		<p class="mt-1 text-zinc-500">Load one on the <a href="/config" class="text-accent hover:underline">Config</a> page.</p>
	</div>
}

templ TasksPage(d TasksPageData) {
	<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
		<div class="max-w-2xl">
			<h1 class="text-xl font-semibold text-zinc-100">Tasks</h1>
			<p class="mt-1 text-sm text-zinc-400">Every task in your Gorunfile. Open one to see what it runs, how it is set up, what it depends on and where it runs. Sorted slowest first by average time in recent runs; tasks that have not run yet come last.</p>
		</div>
		if d.Loaded {
			<input type="search" placeholder="Filter tasks" oninput="gorunFilter(this, 'task-cards')" class={ inputClass() + " max-w-xs" }/>
		}
	</div>
	if !d.Loaded {
		@notLoaded()
	} else if len(d.Tasks) == 0 {
		<p class="text-sm text-zinc-500">This Gorunfile defines no tasks.</p>
	} else {
		<ul id="task-cards" class="space-y-2">
			for _, t := range d.Tasks {
				@taskCard(t)
			}
		</ul>
	}
}

templ taskCard(t TaskCard) {
	<li data-filter={ taskFilter(t) } class="rounded-xl border border-zinc-800 bg-zinc-900/40">
		<details class="group/task">
			<summary class="flex cursor-pointer list-none flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
				<span class="inline-block text-zinc-500 transition group-open/task:rotate-90">▸</span>
				<span class="font-mono text-sm font-semibold text-zinc-100">{ t.Name }</span>
				if t.Description != "" {
					<span class="min-w-0 flex-1 truncate text-sm text-zinc-400">{ t.Description }</span>
				}
				for _, b := range t.Badges {
					<span class="rounded bg-zinc-800 px-1.5 py-0.5 text-[11px] text-zinc-300">{ b }</span>
				}
				if t.Average > 0 {
					<span class="ml-auto font-mono text-xs text-zinc-400" title="Average over recent runs">avg { formatDuration(t.Average) }</span>
				}
			</summary>
			<div class="space-y-4 border-t border-zinc-800 px-4 py-4 text-xs">
				if t.Details != "" {
					<p class="text-sm text-zinc-300">{ t.Details }</p>
				}
				<details class="group/cmd">
					<summary class="flex cursor-pointer list-none items-center gap-2">
						<span class="inline-block text-zinc-500 transition group-open/cmd:rotate-90">▸</span>
						<span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Command</span>
						<span class="font-mono text-[11px] text-zinc-600">{ t.CommandSource }</span>
					</summary>
					<pre class="mt-2 max-h-80 overflow-auto whitespace-pre-wrap break-all rounded-lg bg-zinc-950 p-2 font-mono text-zinc-200">{ t.Command }</pre>
				</details>
				if len(t.Options) > 0 {
					<details class="group/opts">
						<summary class="flex cursor-pointer list-none items-center gap-2">
							<span class="inline-block text-zinc-500 transition group-open/opts:rotate-90">▸</span>
							<span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Options</span>
						</summary>
						<dl class="mt-2 grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-3 lg:grid-cols-5">
							for _, o := range t.Options {
								<div>
									<dt class="text-[11px] uppercase tracking-wider text-zinc-500">{ o.Name }</dt>
									<dd class="mt-0.5 font-mono text-zinc-200">{ o.Value }</dd>
								</div>
							}
						</dl>
					</details>
				}
				@linkRow("Depends on", t.DependsOn, "none")
				@linkRow("In bundles", t.InBundles, "none")
				@linkRow("Runs on", runsOn(t.RunsOn), "no server runs it")
				if len(t.Files) > 0 {
					<details class="group/files">
						<summary class="flex cursor-pointer list-none items-center gap-2">
							<span class="inline-block text-zinc-500 transition group-open/files:rotate-90">▸</span>
							<span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Referenced files</span>
						</summary>
						<ul class="mt-2 space-y-1 text-[11px]">
							for _, f := range t.Files {
								<li class="rounded bg-zinc-800/40 px-2 py-1">
									<div class="text-zinc-500">{ f.Type }</div>
									<a href={ filePath(f.Path) } target="_blank" class="font-mono text-accent hover:underline break-all">{ f.Path }</a>
								</li>
							}
						</ul>
					</details>
				}
				@varsPanel("Task", t.EnvVars, t.Vars)
				if len(t.ConfigVars) > 0 {
					<details class="group/cfgvars">
						<summary class="flex cursor-pointer list-none items-center gap-2">
							<span class="inline-block text-zinc-500 transition group-open/cfgvars:rotate-90">▸</span>
							<span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Config vars</span>
						</summary>
						<pre class="mt-2 max-h-64 overflow-auto rounded-lg bg-zinc-950 p-2 font-mono text-zinc-300">{ varsJSON(t.ConfigVars) }</pre>
					</details>
				}
				if t.Source != "" {
					<p class="font-mono text-zinc-600">Defined in { t.Source }</p>
				}
			</div>
		</details>
	</li>
}

// linkRow is a labelled list of names, or what to say when there are none.
templ linkRow(label string, items []string, none string) {
	<div class="flex flex-wrap items-baseline gap-2">
		<span class="w-20 shrink-0 text-[11px] font-semibold uppercase tracking-wider text-zinc-500">{ label }</span>
		if len(items) == 0 {
			<span class="text-zinc-500">{ none }</span>
		}
		for _, it := range items {
			<span class="rounded bg-zinc-800 px-1.5 py-0.5 font-mono text-zinc-300">{ it }</span>
		}
	</div>
}

templ BundlesPage(d BundlesPageData) {
	<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
		<div class="max-w-2xl">
			<h1 class="text-xl font-semibold text-zinc-100">Bundles</h1>
			<p class="mt-1 text-sm text-zinc-400">A bundle is a named list of tasks, written <span class="font-mono">{ "@name" }</span> wherever a task list goes. Open one to see its tasks in order and everything it expands to.</p>
		</div>
		if d.Loaded {
			<input type="search" placeholder="Filter bundles" oninput="gorunFilter(this, 'bundle-cards')" class={ inputClass() + " max-w-xs" }/>
		}
	</div>
	if !d.Loaded {
		@notLoaded()
	} else if len(d.Bundles) == 0 {
		<p class="text-sm text-zinc-500">This Gorunfile defines no bundles.</p>
	} else {
		<ul id="bundle-cards" class="space-y-2">
			for _, b := range d.Bundles {
				@bundleCard(b)
			}
		</ul>
	}
}

templ bundleCard(b BundleCard) {
	<li data-filter={ bundleFilter(b) } class="rounded-xl border border-zinc-800 bg-zinc-900/40">
		<details class="group/bundle">
			<summary class="flex cursor-pointer list-none flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
				<span class="inline-block text-zinc-500 transition group-open/bundle:rotate-90">▸</span>
				<span class="font-mono text-sm font-semibold text-zinc-100">{ "@" + b.Name }</span>
				if b.Description != "" {
					<span class="min-w-0 flex-1 truncate text-sm text-zinc-400">{ b.Description }</span>
				}
				<span class="ml-auto text-xs text-zinc-400">{ itoa(len(b.Expanded)) } tasks</span>
			</summary>
			<div class="space-y-4 border-t border-zinc-800 px-4 py-4 text-xs">
				<details class="group/items">
					<summary class="flex cursor-pointer list-none items-center gap-2">
						<span class="inline-block text-zinc-500 transition group-open/items:rotate-90">▸</span>
						<span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Tasks in bundle</span>
					</summary>
					<ol class="mt-2 divide-y divide-zinc-800/60 rounded-lg border border-zinc-800 bg-zinc-950">
						for i, it := range b.Items {
							<li class="flex items-baseline gap-3 px-3 py-1.5">
								<span class="w-5 text-right font-mono text-zinc-600">{ itoa(i+1) }</span>
								<span class="font-mono text-zinc-100">{ it.Ref }</span>
								if it.IsBundle {
									<span class="rounded bg-violet-500/15 px-1.5 py-0.5 text-[10px] uppercase text-violet-300">bundle</span>
								}
								<span class="min-w-0 truncate text-zinc-500">{ it.Description }</span>
							</li>
						}
					</ol>
				</details>
				@linkRow("Expands to", b.Expanded, "no tasks")
				@linkRow("Used by", b.UsedBy, "no other bundle")
				if len(b.Vars) > 0 {
					<details class="group/bvars">
						<summary class="flex cursor-pointer list-none items-center gap-2">
							<span class="inline-block text-zinc-500 transition group-open/bvars:rotate-90">▸</span>
							<span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500">Bundle vars</span>
						</summary>
						<pre class="mt-2 max-h-64 overflow-auto rounded-lg bg-zinc-950 p-2 font-mono text-zinc-300">{ varsJSON(b.Vars) }</pre>
					</details>
				}
				<div class="flex items-center justify-between gap-3">
					if b.Source != "" {
						<p class="font-mono text-zinc-600">Defined in { b.Source }</p>
					}
					<a href={ runBundlePath(b.Name) } class="rounded-lg bg-accent px-3 py-1.5 font-semibold text-white transition hover:bg-violet-600">Run this bundle</a>
				</div>
			</div>
		</details>
	</li>
}
