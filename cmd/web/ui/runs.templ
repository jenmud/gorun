package ui

import (
	"os"
	"gorun/internal/store"
)

func isLocal(r store.RunSummary) bool {
	h, err := os.Hostname()
	if err != nil {
		return true
	}
	if r.Hostname == "" {
		return true
	}
	return r.Hostname == h
}

func isLocalRun(r store.RunDetail) bool {
	h, err := os.Hostname()
	if err != nil {
		return true
	}
	if r.Hostname == "" {
		return true
	}
	return r.Hostname == h
}

templ RunsList(runs []store.RunSummary) {
	@Base("Gorun - Runs") {
		<div class="min-h-screen bg-zinc-950 text-zinc-100">
			<div class="border-b border-zinc-800 bg-zinc-900/80 px-6 py-3 backdrop-blur">
				<div class="mx-auto flex max-w-5xl items-center gap-3">
					<a href="/" class="rounded bg-accent px-2 py-0.5 text-sm font-bold text-white">gorun</a>
					<span class="text-sm text-zinc-400">historical runs</span>
				</div>
			</div>
			<main class="mx-auto max-w-5xl px-6 py-6">
				<div class="mb-4 flex items-center justify-between">
					<h1 class="text-2xl font-bold">Runs</h1>
					<form method="post" action="/runs/truncate">
						<button type="submit" class="rounded bg-red-600 px-3 py-1 text-xs text-white hover:bg-red-500">Keep 10 most recent</button>
					</form>
				</div>
				if len(runs) == 0 {
					<p class="text-zinc-500">No runs recorded yet.</p>
				} else {
					<div class="space-y-2">
						for _, r := range runs {
							<a href={ "/runs/" + r.ID } class="block rounded-xl border border-zinc-800 bg-zinc-900/40 p-4 transition hover:border-zinc-700">
								<div class="flex items-center justify-between">
									<div>
										<span class="font-mono text-sm text-zinc-200">{ r.ID }</span>
										<span class="ml-2 text-xs text-zinc-500">{ r.Title }</span>
										if isLocal(r) {
											<span class="ml-2 rounded bg-zinc-800 px-1.5 py-0.5 text-xs text-zinc-300">local</span>
										} else {
											<span class="ml-2 rounded bg-amber-900/40 px-1.5 py-0.5 text-xs text-amber-300">{ r.Hostname }</span>
										}
									</div>
									<div class="text-xs">
										if !r.Finished {
											<span class="text-accent">● running</span>
											<span class="ml-2 text-zinc-500">in progress</span>
										} else if r.Success {
											<span class="text-green-400">✓ success</span>
											<span class="ml-2 text-zinc-500">{ int(r.Duration / 1000000000) }s</span>
										} else {
											<span class="text-red-400">✗ failed</span>
											<span class="ml-2 text-zinc-500">{ int(r.Duration / 1000000000) }s</span>
										}
									</div>
								</div>
								<div class="mt-1 text-xs text-zinc-500">
									if !r.Finished {
										{ r.Failed } failed · in progress — { r.StartedAt.Format("2006-01-02 15:04:05") }
									} else {
										{ r.Servers } servers · { r.TotalTasks } tasks, { r.Failed } failed, { r.Skipped } skipped — { r.StartedAt.Format("2006-01-02 15:04:05") }
									}
								</div>
							</a>
						}
					</div>
				}
			</main>
		</div>
	}
}

templ RunDetail(run store.RunDetail) {
	@Base("Gorun - Run " + run.ID) {
		<div class="min-h-screen bg-zinc-950 text-zinc-100">
			<div class="border-b border-zinc-800 bg-zinc-900/80 px-6 py-3 backdrop-blur">
				<div class="mx-auto flex max-w-5xl items-center gap-3">
					<a href="/" class="rounded bg-accent px-2 py-0.5 text-sm font-bold text-white">gorun</a>
					<a href="/runs" class="text-sm text-zinc-400 hover:text-zinc-200">runs</a>
					<span class="text-sm text-zinc-500">/</span>
					<span class="font-mono text-sm text-zinc-300">{ run.ID }</span>
					if isLocalRun(run) {
						<span class="ml-2 rounded bg-zinc-800 px-1.5 py-0.5 text-xs text-zinc-300">local</span>
					} else {
						<span class="ml-2 rounded bg-amber-900/40 px-1.5 py-0.5 text-xs text-amber-300">{ run.Hostname }</span>
					}
				</div>
			</div>
			<main class="mx-auto max-w-5xl px-6 py-6">
				<h1 class="mb-2 text-2xl font-bold">{ run.Title }</h1>
				<div class="mb-4 text-sm text-zinc-400">
					if !run.Finished {
						<span class="text-accent">● running</span>
						<span class="ml-2">{ run.Failed } failed · in progress</span>
					} else if run.Success {
						<span class="text-green-400">✓ success</span>
						<span class="ml-2">{ run.TotalTasks } tasks, { run.Failed } failed, { run.Skipped } skipped</span>
						<span class="ml-2 text-zinc-500">{ int(run.Duration / 1000000000) }s</span>
					} else {
						<span class="text-red-400">✗ failed</span>
						<span class="ml-2">{ run.TotalTasks } tasks, { run.Failed } failed, { run.Skipped } skipped</span>
						<span class="ml-2 text-zinc-500">{ int(run.Duration / 1000000000) }s</span>
					}
				</div>
				<div class="space-y-4">
					for _, srv := range run.Servers {
						<details class={ serverCardClass(runServerHasFailed(run, srv) && run.Finished) }>
							<summary class="flex cursor-pointer list-none items-center justify-between gap-2">
								<span class={ serverNameClass(runServerHasFailed(run, srv) && run.Finished) }>{ srv }</span>
								{{ total, d, o, f, dur := serverStats(run, srv) }}
								<span class="text-xs text-zinc-500">{ d }/{ total } done · { o } ok · { f } failed · { int(dur / 1000000000) }s</span>
								<span class="text-xs text-zinc-500">expand for tasks</span>
							</summary>
							<div class="mt-3 space-y-2">
								for _, t := range run.Tasks {
									if t.Server == srv {
										<div class="rounded border border-zinc-800 bg-zinc-950/40 p-2">
											<div class="flex items-center gap-2 text-sm">
												if t.State == 2 {
													<span class="text-green-400">✓</span>
												} else if t.State == 3 {
													<span class="font-bold text-red-400">✗</span>
												} else if t.State == 4 {
													<span class="text-amber-400">⊘</span>
												} else if t.State == 1 {
													<span class="animate-pulse text-accent">●</span>
												} else {
													<span class="text-zinc-500">○</span>
												}
												<span class="text-zinc-200">{ t.Name }</span>
												if t.Duration > 0 {
													<span class="text-zinc-500">{ int(t.Duration / 1000000000) }s</span>
												}
												if t.ExitCode != 0 {
													<span class="text-red-400">exit { t.ExitCode }</span>
												}
											</div>
											if t.Command != "" {
												<details class="mt-2">
													<summary class="cursor-pointer text-xs text-zinc-400 hover:text-zinc-200">command</summary>
													<pre class="mt-1 max-h-48 overflow-auto rounded bg-zinc-950 p-2 text-xs text-zinc-300">{ t.Command }</pre>
												</details>
											}
											if t.Stdout != "" {
												<details class="mt-2">
													<summary class="cursor-pointer text-xs text-zinc-500 hover:text-zinc-300">stdout</summary>
													<pre class="mt-1 max-h-48 overflow-auto rounded bg-zinc-950 p-2 text-xs text-zinc-300">{ t.Stdout }</pre>
												</details>
											}
											if t.Stderr != "" {
												<details class="mt-2">
													<summary class="cursor-pointer text-xs text-red-400 hover:text-red-300">stderr</summary>
													<pre class="mt-1 max-h-48 overflow-auto rounded bg-red-950/30 p-2 text-xs text-red-300">{ t.Stderr }</pre>
												</details>
											}
										</div>
									}
								}
							</div>
						</details>
					}
				</div>
				<div class="mt-6 flex items-center gap-4">
					<a href="/runs" class="text-sm text-zinc-400 hover:text-zinc-200">← back to runs</a>
					<form method="post" action={ "/runs/" + run.ID + "/delete" }>
						<button type="submit" class="rounded bg-red-600 px-3 py-1 text-xs text-white hover:bg-red-500">delete run</button>
					</form>
				</div>
			</main>
		</div>
	}
}