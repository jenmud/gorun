#
# Gorunfile: provisions the app servers with Docker and a deploy user.
#
# Usage (from this directory, so relative paths resolve):
#   go run .. Gorunfile
#
# Every task and script is idempotent, so the whole file is safe to re-run.
# To reproduce a failed task by hand on a server:
#   cmd:      ssh -i ssh-keys/id_ecdsa -p 2221 testuser@localhost "sudo sh -c '<cmd>'"
#   cmd_file: scp -i ssh-keys/id_ecdsa -P 2221 scripts/<file>.sh testuser@localhost:
#             ssh -i ssh-keys/id_ecdsa -p 2221 testuser@localhost "sudo sh <file>.sh"
#
title = "Provision app servers"
log_level = "info"

#
# Tasks in this section run on every server, in dependency order.
# Servers can add their own tasks below; task names must be unique.
#

[[tasks]]
name = "packages"
cmd_file = "./scripts/packages.sh"
sudo = true

[[tasks]]
name = "docker-install"
cmd_file = "./scripts/docker-install.sh"
sudo = true
depends_on = ["packages"]

[[tasks]]
name = "deploy-user"
cmd_file = "./scripts/deploy-user.sh"
sudo = true
depends_on = ["docker-install"]

[[tasks]]
name = "verify"
cmd = "docker --version && docker compose version && id deploy"
depends_on = ["deploy-user"]

#
# Inventory. SSH settings are per server (there is no global fallback).
# Key-based auth only: no passwords in this file.
#

[[servers]]
name = "server1"
hostname = "localhost"

    [servers.ssh]
    port = 2221
    username = "testuser"
    identityfile = "./ssh-keys/id_ecdsa"

[[servers]]
name = "server2"
hostname = "localhost"

    [servers.ssh]
    port = 2222
    username = "testuser"
    identityfile = "./ssh-keys/id_ecdsa"

    # server-specific: let the SSH user run docker without sudo
    [[servers.tasks]]
    name = "ssh-user-docker-access"
    cmd = "usermod -aG docker testuser"
    sudo = true
    depends_on = ["docker-install"]
