#
# Gorunfile: provisions the app servers with Docker, dev tooling, and a deploy user.
#
# Usage (relative paths resolve from this file's directory, so run it from anywhere):
#   go run . example/Gorunfile
#   go run . example/Gorunfile --select
#
# Every task and script is idempotent, so the whole file is safe to re-run.
# To reproduce a failed task by hand on a server:
#   cmd:      ssh -i ssh-keys/id_ecdsa -p 2221 testuser@localhost "sudo sh -c '<cmd>'"
#   cmd_file: scp -i ssh-keys/id_ecdsa -P 2221 scripts/<file>.sh testuser@localhost:
#             ssh -i ssh-keys/id_ecdsa -p 2221 testuser@localhost "sudo sh <file>.sh"
#
title = "Provision app servers"
log_level = "info"

#
# Task library. Each [tasks.<name>] defines a task once; servers pick tasks by name.
# A task's depends_on are always pulled in and run first, so a server only needs to
# list the tasks it wants and gets everything they need.
#
# Dependency graph:
#
#   packages ─┬─ timezone
#             ├─ monitoring-tools (htop, btop)
#             ├─ cli-tools ─┬─ jj-install ──────────────┐
#             │             └─ golang-install ─┐        │
#             ├─ neovim-install ─┬─ editor-setup        │
#             │                  └──────────────────────┼─ jj-config
#             └─ docker-install ── deploy-user ─┬───────┘
#                                               └─ go-workspace
#   verify depends on all the leaves above.
#   go-smoke-test, ssh-user-docker-access and compose-project are only used by some servers.
#

[tasks.apt-update]
cmd = "apt update"
sudo = true

[tasks.packages]
cmd_file = "./scripts/packages.sh"
sudo = true

[tasks.timezone]
cmd = "cp /usr/share/zoneinfo/UTC /etc/localtime && echo UTC > /etc/timezone"
sudo = true
depends_on = ["packages"]

[tasks.monitoring-tools]
cmd = "apk add --no-cache htop btop"
sudo = true
depends_on = ["packages"]

[tasks.cli-tools]
cmd = "apk add --no-cache git jq ripgrep fd fzf tmux make"
sudo = true
depends_on = ["packages"]

[tasks.jj-install]
cmd = "apk add --no-cache jujutsu"
sudo = true
depends_on = ["cli-tools"]

[tasks.golang-install]
cmd_file = "./scripts/golang-install.sh"
sudo = true
depends_on = ["cli-tools"]

[tasks.neovim-install]
cmd = "apk add --no-cache neovim"
sudo = true
depends_on = ["packages"]

[tasks.editor-setup]
cmd_file = "./scripts/editor-setup.sh"
sudo = true
depends_on = ["neovim-install"]

[tasks.docker-install]
cmd_file = "./scripts/docker-install.sh"
sudo = true
depends_on = ["packages"]

[tasks.deploy-user]
cmd_file = "./scripts/deploy-user.sh"
sudo = true
depends_on = ["docker-install"]

[tasks.jj-config]
cmd_file = "./scripts/jj-config.sh"
sudo = true
depends_on = ["jj-install", "neovim-install", "deploy-user"]

[tasks.go-workspace]
cmd = "su - deploy -c 'mkdir -p ~/go/bin ~/src && go env GOPATH'"
sudo = true
depends_on = ["golang-install", "deploy-user"]

[tasks.verify]
cmd_file = "./scripts/verify.sh"
depends_on = ["timezone", "monitoring-tools", "editor-setup", "jj-config", "go-workspace"]

[tasks.go-smoke-test]
cmd_file = "./scripts/go-smoke-test.sh"
sudo = true
depends_on = ["go-workspace"]

[tasks.ssh-user-docker-access]
cmd = "usermod -aG docker testuser"
sudo = true
depends_on = ["docker-install"]

[tasks.compose-project]
cmd_file = "./scripts/compose-project.sh"
sudo = true
depends_on = ["deploy-user"]

[tasks.iptables-setup]
[[tasks.iptables-setup.copy]]
src_template = "./templates/iptables-rules.sh.tmpl"
dst = "/etc/iptables-rules.sh"
cmd_template = "sh /etc/iptables-rules.sh"
sudo = true
depends_on = ["packages"]

[tasks.greet]
cmd_template = "echo 'hello from {{.Name}} on {{.Hostname}}'"

#
# Inventory. Every host runs servers.tasks unless it sets its own `tasks`, which
# replaces the global list (dependencies are still pulled in).
# SSH settings are per server (there is no global fallback).
# Key-based auth only: no passwords in this file.
#

[servers]
tasks = ["iptables-setup", "greet", "timezone", "monitoring-tools", "editor-setup", "jj-config", "go-workspace", "verify"]

[servers.hosts.server1]
hostname = "localhost"
# build server: the usual setup, plus prove the Go toolchain works end to end
tasks = ["verify", "go-smoke-test", "apt-update"]
    [servers.hosts.server1.ssh]
    port = 2221
    username = "testuser"
    identityfile = "./ssh-keys/id_ecdsa"

[servers.hosts.server2]
hostname = "localhost"
# docker host: the usual setup, plus docker without sudo and the app's compose project
tasks = ["verify", "ssh-user-docker-access", "compose-project"]
    [servers.hosts.server2.ssh]
    port = 2222
    username = "testuser"
    identityfile = "./ssh-keys/id_ecdsa"

