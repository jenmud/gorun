#
# Gorunfile: provisions the app servers with Docker, dev tooling, and a deploy user.
#
# Usage (relative paths resolve from this file's directory, so run it from anywhere):
#   go run ./cmd example/Gorunfile                  # pick servers and tasks, then run
#   go run ./cmd example/Gorunfile --run            # run everything, no picker (-r)
#   go run ./cmd example/Gorunfile --tag prod --exclude-server 'db-*'
#   go run ./cmd example/Gorunfile --group eu --task @baseline
#   go run ./cmd example/Gorunfile --list-servers --tag web
#
# Every task and script is idempotent, so the whole file is safe to re-run.
# To reproduce a failed task by hand on a server:
#   cmd:      ssh -i ssh-keys/id_ecdsa -p 2221 testuser@localhost "sudo sh -c '<cmd>'"
#   cmd_file: scp -i ssh-keys/id_ecdsa -P 2221 scripts/<file>.sh testuser@localhost:
#             ssh -i ssh-keys/id_ecdsa -p 2221 testuser@localhost "sudo sh <file>.sh"
#
title = "Provision app servers"
log_level = "info"
# max_parallel = 4

#
# Task library. Each [tasks.<name>] defines a task once; servers pick tasks by name.
# A task's depends_on are always pulled in and run first, so a server only needs to
# list the tasks it wants and gets everything they need.

[tasks.apt-update]
cmd = "apt update"
sudo = true

[tasks.packages]
cmd_file = "./scripts/packages.sh"
description = "Install the base package set"
rerun = "safe"
retries = 1
retry_delay = "1s"
sudo = true
timeout = "1m30s"

[tasks.timezone]
cmd = "cp /usr/share/zoneinfo/UTC /etc/localtime && echo UTC > /etc/timezone"
description = "Set the system timezone to UTC"
details = "Copies the UTC zoneinfo file and writes /etc/timezone so the change survives reboots."
rerun = "safe"
sudo = true
depends_on = ["packages"]

[tasks.monitoring-tools]
cmd = "apk add --no-cache htop btop"
sudo = true
depends_on = ["packages"]

[tasks.cli-tools]
cmd = "apk add --no-cache git jq ripgrep fd fzf tmux make"
sudo = true
depends_on = ["packages"]

[tasks.jj-install]
cmd = "apk add --no-cache jujutsu"
sudo = true
depends_on = ["cli-tools"]

[tasks.golang-install]
cmd_file = "./scripts/golang-install.sh"
sudo = true
depends_on = ["cli-tools"]

[tasks.neovim-install]
cmd = "apk add --no-cache neovim"
sudo = true
depends_on = ["packages"]

[tasks.editor-setup]
cmd_file = "./scripts/editor-setup.sh"
sudo = true
depends_on = ["neovim-install"]

[tasks.docker-install]
cmd_file = "./scripts/docker-install.sh"
sudo = true
depends_on = ["packages"]

[tasks.deploy-user]
cmd_file = "./scripts/deploy-user.sh"
description = "Create the deploy user and add it to the docker group"
rerun = "safe"
sudo = true
depends_on = ["docker-install"]

[tasks.jj-config]
cmd_file = "./scripts/jj-config.sh"
sudo = true
depends_on = ["jj-install", "neovim-install", "deploy-user"]

[tasks.go-workspace]
cmd = "su - deploy -c 'mkdir -p ~/go/bin ~/src && go env GOPATH'"
sudo = true
depends_on = ["golang-install", "deploy-user"]

[tasks.verify]
cmd_file = "./scripts/verify.sh"
description = "Check the server is configured correctly"
rerun = "safe"
depends_on = ["timezone", "monitoring-tools", "editor-setup", "jj-config", "go-workspace"]

[tasks.go-smoke-test]
cmd_file = "./scripts/go-smoke-test.sh"
sudo = true
depends_on = ["go-workspace"]

[tasks.ssh-user-docker-access]
cmd = "usermod -aG docker testuser"
sudo = true
depends_on = ["docker-install"]

[tasks.compose-project]
cmd_file = "./scripts/compose-project.sh"
sudo = true
depends_on = ["deploy-user"]

# Copy a whole directory tree recursively (like `scp -r`). With `dst`, the remote
# directory receives the contents of ./files/app; it is created if missing and
# existing files are overwritten. Copy-only tasks need no cmd.
[tasks.app-files]
[[tasks.app-files.copy]]
src = "./files/app"
dst = "/tmp/app"

[tasks.greet]
cmd_template = "echo 'hello from {{.Name}} on {{.Hostname}}:{{.SSH.Port}} ({{.SSH.User}}) -> {{.SSH.Identityfile}}'"

# Templates see the server after its groups are applied, so .Tags and .EnvVars include
# what the groups added.
[tasks.server-info]
cmd_template = "echo '{{.Name}}: region={{index .EnvVars \"REGION\"}} env={{index .EnvVars \"APP_ENV\"}} tags={{range .Tags}}{{.}} {{end}}'"
description = "Print the region, environment and tags the server ended up with"
rerun = "safe"

#
# Bundles name a list of tasks so it can be reused. Use them as "@name" in any task
# list (servers.tasks, a host's tasks / add_tasks / skip_tasks, a group's tasks,
# another bundle) or on the command line with --task @name.
#

[bundles.baseline]
description = "Minimal setup every box gets"
tasks = ["timezone", "monitoring-tools"]

[bundles.devtools]
description = "Editor, jj and a Go workspace for the deploy user"
tasks = ["editor-setup", "jj-config", "go-workspace"]

[bundles.standard]
description = "The usual app server setup"
tasks = ["greet", "@baseline", "@devtools", "verify"]   # bundles can include bundles

#
# Server groups share defaults between the hosts that list them in `groups`.
# Later groups override earlier ones, and the host's own settings win:
#   - ssh fields and log_level: the last one set wins
#   - envvars: merged by key
#   - tags: all of them
#   - tasks: appended to servers.tasks (unless the host sets its own tasks)
#

# Every machine in the docker-compose lab: shared SSH login, so hosts only set a port.
[server_groups.lab]
tags = ["lab"]
    [server_groups.lab.ssh]
    username = "testuser"
    identityfile = "./ssh-keys/id_ecdsa"   # key-based auth only: no passwords in this file

[server_groups.prod]
tags = ["prod"]
envvars = { APP_ENV = "production" }

[server_groups.staging]
tags = ["staging"]
log_level = "debug"
envvars = { APP_ENV = "staging" }

[server_groups.eu]
tags = ["eu"]
tasks = ["server-info"]
envvars = { REGION = "eu-west-1" }

[server_groups.db]
tags = ["db"]

#
# Inventory. Every host runs servers.tasks plus its groups' tasks, unless it sets its
# own `tasks`, which replaces both. add_tasks then appends and skip_tasks removes.
# Dependencies are always pulled in.
#
# Try:  --tag web · --group eu · --tag prod --tag db · --server 'worker-*' · --exclude-server 'db-*'
#

[servers]
tasks = ["@standard"]

[servers.hosts.server1]
hostname = "localhost"
groups = ["lab"]
tags = ["build"]
# build server: the usual setup, plus prove the Go toolchain works end to end
add_tasks = ["go-smoke-test", "apt-update"]
    [servers.hosts.server1.ssh]
    port = 2221

[servers.hosts.server2]
hostname = "localhost"
groups = ["lab"]
tags = ["docker"]
# docker host: the usual setup, plus docker without sudo and the app's compose project
add_tasks = ["ssh-user-docker-access", "compose-project", "app-files"]
    [servers.hosts.server2.ssh]
    port = 2222

[servers.hosts.web-prod-1]
hostname = "localhost"
groups = ["lab", "prod"]
tags = ["web"]
    [servers.hosts.web-prod-1.ssh]
    port = 2223

[servers.hosts.web-prod-2]
hostname = "localhost"
groups = ["lab", "prod"]
tags = ["web"]
    [servers.hosts.web-prod-2.ssh]
    port = 2224

[servers.hosts.db-primary]
hostname = "localhost"
groups = ["lab", "prod", "db"]
# database boxes stay minimal: their own list replaces servers.tasks
tasks = ["@baseline"]
    [servers.hosts.db-primary.ssh]
    port = 2225

[servers.hosts.db-replica-eu]
hostname = "localhost"
groups = ["lab", "prod", "db", "eu"]
# its own tasks also replace the eu group's tasks, so add server-info back
tasks = ["@baseline"]
add_tasks = ["server-info"]
    [servers.hosts.db-replica-eu.ssh]
    port = 2226

[servers.hosts.cache-redis]
hostname = "localhost"
groups = ["lab", "prod"]
tags = ["cache"]
skip_tasks = ["greet"]   # the usual setup, minus the greeting
    [servers.hosts.cache-redis.ssh]
    port = 2227

[servers.hosts.worker-eu-a]
hostname = "localhost"
groups = ["lab", "prod", "eu"]   # gets the eu group's server-info task
tags = ["worker"]
    [servers.hosts.worker-eu-a.ssh]
    port = 2228

[servers.hosts.worker-eu-b]
hostname = "localhost"
groups = ["lab", "prod", "eu"]
tags = ["worker"]
envvars = { REGION = "eu-central-1" }   # the host wins over the eu group
    [servers.hosts.worker-eu-b.ssh]
    port = 2229

[servers.hosts.staging-api]
hostname = "localhost"
groups = ["lab", "staging"]
tags = ["api"]
tasks = ["verify", "compose-project"]
    [servers.hosts.staging-api.ssh]
    port = 2230
