#
# Gorunfile is a TOML formatted file.
#
title = "Deployment for example server"
log_level = "info"

# Global SSH details
[ssh]
username = "testuser"
# password = "testpassword"
identityfile = "./ssh-keys/id_ecdsa"

# Global environment variables
[envvars]
GORUN_ADDRESS = "localhost:8080"

# List of servers in the inventory
[[servers]]
name = "server1"
hostname = "localhost"
log_level = "info"

    [servers.ssh]
    port = 2221
    username = "testuser"
    password = "testpassword"
    identityfile = "./ssh-keys/id_ecdsa"

    [[servers.tasks]]
    name = "create-docker-group"
    cmd = "getent group docker || groupadd docker"
    sudo = true

    [[servers.tasks]]
    name = "create-users"
    sudo = true
    cmd = "id foobar || useradd -m -s /bin/bash -G docker foobar"
    depends_on = ["create-docker-group", "docker-install"]

    [[servers.tasks]]
    name = "pkg-install"
    cmd_file = "./scripts/pkg-install.sh"

    [[servers.tasks]]
    name = "docker-install"
    cmd_file = "./scripts/install-docker.sh"
    depends_on = ["pkg-install"]


[[servers]]
name = "server2"
hostname = "localhost"
log_level = "info"

    [servers.ssh]
        port = 2222
        username = "testuser"
        password = "testpassword"
        identityfile = "./ssh-keys/id_ecdsa"

    [[servers.tasks]]
    name = "create-docker-group"
    cmd = "getent group docker || groupadd docker"
    sudo = true

    [[servers.tasks]]
    name = "create-users"
    sudo = true
    cmd = "id foobar || useradd -m -s /bin/bash -G docker foobar"
    depends_on = ["create-docker-group", "docker-install"]

    [[servers.tasks]]
    name = "update-testuser-groups"
    sudo = true
    cmd="usermod -aG docker testuser"
    depends_on = ["create-docker-group", "docker-install"]

    [[servers.tasks]]
    name = "pkg-install"
    cmd_file = "./scripts/pkg-install.sh"

    [[servers.tasks]]
    name = "docker-install"
    cmd_file = "./scripts/install-docker.sh"
    depends_on = ["pkg-install"]
