log_level = "debug"

[tasks.install-netstat]
cmd = "pacman -S --noconfirm --needed net-tools"
sudo = true

[tasks.install-tree]
cmd = "pacman -S --noconfirm --needed tree"
sudo = true

[tasks.install-nats]
cmd_file = "./scripts/install-nats-cli.sh"

[servers]
tasks = ["install-tree", "install-netstat", "install-nats"]

# no hostname or ssh: tasks run on this machine
[servers.hosts.local-machine]
