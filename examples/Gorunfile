#
# Gorunfile is a TOML formatted file.
#
title = "Deployment for example server"
log_level = "info"

# Global SSH details
[ssh]
username = "testuser"
# password = "testpassword"
identityfile = "./ssh-keys/id_ecdsa"

# Global environment variables
[envvars]
GORUN_ADDRESS = "localhost:8080"

# List of servers in the inventory
[[servers]]
name = "server1"
hostname = "localhost"
log_level = "debug"

    [servers.ssh]
    port = 2221
    username = "testuser"
    password = "testpassword"
    identityfile = "./ssh-keys/id_ecdsa"

    [[servers.tasks]]
    name = "create-users"
    cmd_file = "./scripts/create-users.sh"
    depends_on = ["install-docker"]

    [[servers.tasks]]
    name = "install-docker"
    cmd_file = "./scripts/install-docker.sh"
    depends_on = ["apt-install"]

    [[servers.tasks]]
    name = "apt-install"
    #cmd = "sudo apt update"
    cmd_file = "./scripts/apt-install.sh"


