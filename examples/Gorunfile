#
# Gorunfile is a TOML formatted file.
#
title = "Deployment for example server"
log_level = "info"

# Global SSH details
[ssh]
username = "testuser"
# password = "testpassword"
identityfile = "./ssh-keys/id_ecdsa"

# Global environment variables
[envvars]
GORUN_ADDRESS = "localhost:8080"

# List of servers in the inventory
[[servers]]
name = "server1"
hostname = "localhost"
log_level = "debug"

    [servers.ssh]
    port = 2221
    username = "testuser"
    password = "testpassword"
    identityfile = "./ssh-keys/id_ecdsa"

    [[servers.tasks]]
    name = "create-users"
    cmd = "./scripts/create-users.sh"
    depends_on = ["install-docker"]

    [[servers.tasks]]
    name = "install-docker"
    cmd = "./scripts/install-docker.sh"


[[servers]]
name = "server2"
hostname = "localhost"
log_level = "debug"

    [servers.ssh]
        port = 2222
        username = "testuser"
        password = "testpassword"
        identityfile = "./ssh-keys/id_ecdsa"

    [[servers.tasks]]
    name = "create-users"
    cmd = "./scripts/create-users.sh"
    depends_on = ["install-docker"]

    [[servers.tasks]]
    name = "install-docker"
    cmd = "./scripts/install-docker.sh"
