tasks = ["configure-ca-certificates", "configure-tzdata", "configure-sudo", "configure-bash", "configure-zsh", "configure-curl", "configure-wget", "configure-jq", "configure-yq", "configure-fzf", "configure-ripgrep", "configure-fd", "configure-bat", "configure-eza", "configure-htop", "configure-btop", "configure-ncdu", "configure-duf", "configure-tmux", "configure-starship", "configure-tldr", "configure-httpie", "configure-git", "configure-git-lfs", "configure-git-delta", "configure-gh", "configure-jj", "configure-lazygit", "configure-neovim", "configure-vim", "configure-helix", "configure-docker", "configure-compose", "configure-lazydocker", "configure-podman", "configure-go", "configure-rust", "configure-node", "configure-python", "configure-uv", "configure-bun", "configure-pnpm", "configure-psql", "configure-redis-cli", "configure-sqlite3", "configure-mongosh", "configure-nmap", "configure-mtr", "configure-iperf3", "configure-socat", "configure-make", "configure-cmake", "configure-ninja", "configure-gcc", "configure-clang", "configure-gdb", "configure-strace", "configure-ltrace"]

[bundles.smoke-all]
description = "Smoke test every tool"
tasks = ["smoke-ca-certificates", "smoke-tzdata", "smoke-sudo", "smoke-bash", "smoke-zsh", "smoke-curl", "smoke-wget", "smoke-jq", "smoke-yq", "smoke-fzf", "smoke-ripgrep", "smoke-fd", "smoke-bat", "smoke-eza", "smoke-htop", "smoke-btop", "smoke-ncdu", "smoke-duf", "smoke-tmux", "smoke-starship", "smoke-tldr", "smoke-httpie", "smoke-git", "smoke-git-lfs", "smoke-git-delta", "smoke-gh", "smoke-jj", "smoke-lazygit", "smoke-neovim", "smoke-vim", "smoke-helix", "smoke-docker", "smoke-compose", "smoke-lazydocker", "smoke-podman", "smoke-go", "smoke-rust", "smoke-node", "smoke-python", "smoke-uv", "smoke-bun", "smoke-pnpm", "smoke-psql", "smoke-redis-cli", "smoke-sqlite3", "smoke-mongosh", "smoke-nmap", "smoke-mtr", "smoke-iperf3", "smoke-socat", "smoke-make", "smoke-cmake", "smoke-ninja", "smoke-gcc", "smoke-clang", "smoke-gdb", "smoke-strace", "smoke-ltrace"]

[bundles.devserver]
description = "Full massive dev server setup"
tasks = ["@fetch-all", "@install-all", "@configure-all", "@smoke-all", "integration-dev-env", "package-manifest", "package-configs", "checksums", "verify-all"]

[server_groups.lab]
tags = ["lab"]
    [server_groups.lab.ssh]
    username = "testuser"
    identityfile = "../ssh-keys/id_ecdsa"

[server_groups.prod]
tags = ["prod"]
envvars = { APP_ENV = "production" }
tasks = ["server-info"]

[server_groups.staging]
tags = ["staging"]
log_level = "debug"
envvars = { APP_ENV = "staging" }
tasks = ["server-info"]

[server_groups.eu]
tags = ["eu"]
tasks = ["server-info"]
envvars = { REGION = "eu-west-1" }

[server_groups.build]
tags = ["build"]
tasks = ["server-info"]

[server_groups.docker]
tags = ["docker"]
tasks = ["server-info"]

[servers]
tasks = ["verify-all"]

