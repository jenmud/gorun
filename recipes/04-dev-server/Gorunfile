title = "Recipe 4: massive dev server"
log_level = "info"
max_task_parallel = -1

# Every fetch, install and configure step has a check, so the first run sets up all ~60 tools and
# a rerun only runs the smoke tests and the gate: the rest show as unchanged. Installs and
# configures have a verify, so a step that didn't leave its file behind fails on the spot.
#   --check              dry run: which steps would run
#   --force              redo everything
#   --task cleanup       start again from nothing

[tasks.bootstrap]
check = "test -d /tmp/devserver/bin && test -d /tmp/devserver/cfg && test -d /tmp/devserver/test && test -d /tmp/devserver/logs"
cmd = "mkdir -p /tmp/devserver/bin /tmp/devserver/cfg /tmp/devserver/test /tmp/devserver/logs && echo bootstrap ok"
description = "Bootstrap the dev server workspace"
details = "Creates the working directories used by later tasks."

[tasks.fetch-ca-certificates]
check = "test -f /tmp/devserver/logs/ca-certificates.fetched"
cmd = "echo 'fetching ca-certificates' && sleep 0.1 && touch /tmp/devserver/logs/ca-certificates.fetched && echo 'fetched ca-certificates'"
description = "Fetch ca-certificates"
details = "Downloads or locates the ca-certificates package so it can be installed."
depends_on = ["bootstrap"]

[tasks.install-ca-certificates]
check = "test -x /tmp/devserver/bin/ca-certificates"
cmd = "echo 'installing ca-certificates' && sleep 0.1 && printf '#!/bin/sh\\necho ca-certificates ok\\n' > /tmp/devserver/bin/ca-certificates && chmod +x /tmp/devserver/bin/ca-certificates && echo 'installed ca-certificates'"
verify = "/tmp/devserver/bin/ca-certificates"
description = "Install ca-certificates"
details = "Installs ca-certificates onto the server and verifies the binary."
depends_on = ["fetch-ca-certificates"]

[tasks.configure-ca-certificates]
check = "grep -qx 'tool = ca-certificates' /tmp/devserver/cfg/ca-certificates.conf"
cmd = "echo 'configuring ca-certificates' && sleep 0.1 && echo 'tool = ca-certificates' > /tmp/devserver/cfg/ca-certificates.conf && echo 'configured ca-certificates'"
verify = "test -s /tmp/devserver/cfg/ca-certificates.conf"
description = "Configure ca-certificates"
details = "Writes the default configuration for ca-certificates."
depends_on = ["install-ca-certificates"]

[tasks.smoke-ca-certificates]
cmd = "echo 'smoke testing ca-certificates' && sleep 0.1 && /tmp/devserver/bin/ca-certificates && test -s /tmp/devserver/cfg/ca-certificates.conf && echo 'smoke ca-certificates ok'"
description = "Smoke test ca-certificates"
details = "Runs a quick check that ca-certificates works."
depends_on = ["configure-ca-certificates"]

