title = "Recipe 7: big uploads"
log_level = "info"

# Uploads a 1 GB release and a folder of 200 files to three servers, and shows each upload's
# progress. Make the files first: recipes/07-big-upload/make-files.sh
#
# check_copies compares each file with the one already on the server (the server hashes its own
# copy, so only the hashes cross the network): a rerun uploads nothing that is already there.
# Each upload's verify checks it arrived whole. --force uploads everything again.

[tasks.upload-release]
description = "Upload the 1 GB release and its checksum"
details = "A src copy of a single large file: gorun streams it and shows its progress."
check_copies = true
verify = "cd /tmp/gorun-upload/releases/v2.4.0 && sha256sum -c release.sha256"
    [[tasks.upload-release.copy]]
    src = "build/release.tar.gz"
    dst = "/tmp/gorun-upload/releases/v2.4.0/release.tar.gz"
    [[tasks.upload-release.copy]]
    src = "build/release.sha256"
    dst = "/tmp/gorun-upload/releases/v2.4.0/release.sha256"

[tasks.upload-site]
description = "Upload the static site"
details = "A src copy of a directory: one bar counts every file in it."
depends_on = ["upload-release"]
check_copies = true
verify = "test $(find /tmp/gorun-upload/releases/v2.4.0/site -type f | wc -l) -eq 200"
    [[tasks.upload-site.copy]]
    src = "build/site"
    dst = "/tmp/gorun-upload/releases/v2.4.0/site"

[tasks.cleanup]
description = "Remove the uploaded files"
cmd = "rm -rf /tmp/gorun-upload"

[bundles.ship]
description = "Upload the release and the site, and verify them"
tasks = ["upload-release", "upload-site"]

[server_groups.lab]
tags = ["lab"]
    [server_groups.lab.ssh]
    username = "testuser"
    identityfile = "../ssh-keys/id_ecdsa"

[servers]
tasks = ["@ship"]

[servers.hosts.server1]
hostname = "localhost"
groups = ["lab"]
    [servers.hosts.server1.ssh]
    port = 2221

[servers.hosts.server2]
hostname = "localhost"
groups = ["lab"]
    [servers.hosts.server2.ssh]
    port = 2222

[servers.hosts.server3]
hostname = "localhost"
groups = ["lab"]
    [servers.hosts.server3.ssh]
    port = 2223
