# The web dashboard demo: the web fleet on local stand-ins (sleeps, no real hosts); the video labels it "Demo run".
title = "Web fleet"
# update and disk come from the stored Gorunfile "base"
include = ["stored::base"]

[[schedule]]
name = "nightly-disk"
description = "Report disk usage every night"
target = "disk"
cron = "0 2 * * *"
timezone = "Australia/Sydney"


[tasks.nginx]
description = "Install nginx"
cmd = "sleep $((8 + RANDOM % 4))"
# stand-ins: nginx-demo never runs here, so the task always runs, and /etc is always there
check = "pgrep -x nginx-demo"
verify = "test -d /etc"
depends_on = ["update"]
local = true

[tasks.site]
description = "Install the site's index page"
cmd = "sleep 1"
depends_on = ["nginx"]
local = true

[tasks.smoke]
description = "Check the site answers"
cmd = "sleep 1; {{if eq .Name \"web-3\"}}echo 'curl: (7) Failed to connect to localhost port 80' >&2; exit 7{{end}}"
timeout = "30s"
depends_on = ["site"]
local = true

[bundles.webapp]
description = "Install nginx, the site, and test it"
tasks = ["nginx", "site", "smoke"]

[server_groups.ubuntu]

[server_groups.web]
tags = ["web"]
tasks = ["@webapp"]

[server_groups.db]
tags = ["db"]
tasks = ["update", "disk"]

[server_groups.prod]
tags = ["prod"]

[server_groups.staging]
tags = ["staging"]

[servers.hosts.web-1]
hostname = "10.0.0.11"
groups = ["ubuntu", "web", "prod"]

[servers.hosts.web-2]
hostname = "10.0.0.12"
groups = ["ubuntu", "web", "prod"]

[servers.hosts.web-3]
hostname = "10.0.0.13"
groups = ["ubuntu", "web", "prod"]

[servers.hosts.web-4]
hostname = "10.0.0.14"
groups = ["ubuntu", "web", "staging"]
add_tasks = ["disk"]

[servers.hosts.db-1]
hostname = "10.0.0.21"
groups = ["ubuntu", "db", "prod"]
